اشمل "مـتم/طـرفية"؛
اشمل "نـبك"؛

صنف أسـاس {
    نـبك.عرف_جدول_دالات[جدول، جـدول]؛

    عرف س: صحيح؛
    ضمن جـدول عملية هذا.هات_ق1(): صحيح كمؤشر {
        أرجع هذا.س؛
    }

    ضمن جـدول عملية هذا.هات_ق2(): صحيح كمؤشر {
        أرجع هذا.س * 2؛
    }
}

صنف ابـن {
    نـبك.اشتق_صنفا[أساس، أسـاس، جدول، جـدول]؛

    عرف ص: صحيح؛
    ضمن جـدول عملية هذا.أساس.هات_ق1(): صحيح حدد_مؤشر {
        أرجع هذا.ص؛
    }
    ضمن جـدول عملية هذا.أساس.هات_ق2(): صحيح حدد_مؤشر {
        أرجع هذا.ص * 2؛
    }
    ضمن جـدول عملية هذا.هات_ق3(): صحيح كمؤشر {
        أرجع هذا.ص * 3؛
    }
}

صنف حـفيد {
    نـبك.اشتق_صنفا[ابن، ابـن، ابن.جدول، ابـن.جـدول، جدول_مشترك، جـدول2]؛

    عرف ع: صحيح؛
    ضمن جـدول2 عملية هذا.ابن.أساس.هات_ق1(): صحيح حدد_مؤشر {
        أرجع هذا.ع + هذا.ابن.أساس._هات_ق1()؛
    }
}

// الوراثة المتعددة

صنف أسـاس2 {
    نـبك.عرف_جدول_دالات[جدول، جـدول]؛

    عرف أ: صحيح؛
    ضمن جـدول عملية هذا.هات_ق1(): صحيح كمؤشر {
        أرجع هذا.أ؛
    }
}

صنف أسـاس_متعدد {
    نـبك.اشتق_صنفا[ابن1، أسـاس، ابن1.جدول، أسـاس.جـدول، جدول_مشترك1، جـدول1]؛
    نـبك.اشتق_صنفا[ابن2، أسـاس2، ابن2.جدول، أسـاس2.جـدول، جدول_مشترك2، جـدول2]؛

    ضمن جـدول1 عملية هذا.ابن1.هات_ق1(): صحيح حدد_مؤشر {
        أرجع هذا.س * 2؛
    }

    ضمن جـدول2 عملية هذا.ابن2.هات_ق1(): صحيح حدد_مؤشر {
        حاذ_هذا[ابن2، أسـاس_متعدد]؛
        أرجع هذا.أ * 2؛
    }
}

صنف ابـن_متعدد {
    نـبك.اشتق_صنفا[ابن، أسـاس_متعدد، ابن.جدول، أسـاس_متعدد.جـدول1، جدول_مشترك، جـدول]؛

    ضمن جـدول عملية هذا.ابن.ابن1.هات_ق1(): صحيح حدد_مؤشر {
        أرجع هذا.س * 3؛
    }
}

صنف ابـن_متعدد2 {
    نـبك.اشتق_صنفا[ابن، أسـاس_متعدد]؛
    نـبك.اشتق_جدول_دالات[ابن، أسـاس_متعدد، ابن1.جدول، أسـاس_متعدد.جـدول1، جدول_مشترك1، جـدول1]؛
    نـبك.اشتق_جدول_دالات[ابن، أسـاس_متعدد، ابن2.جدول، أسـاس_متعدد.جـدول2، جدول_مشترك2، جـدول2]؛


    ضمن جـدول1 عملية هذا.ابن.ابن1.هات_ق1(): صحيح حدد_مؤشر {
        أرجع هذا.س * 4؛
    }
    ضمن جـدول2 عملية هذا.ابن.ابن2.هات_ق1(): صحيح حدد_مؤشر {
        حاذ_هذا[ابن2، أسـاس_متعدد]؛
        أرجع هذا.أ * 4؛
    }
}

دالة اختبر_أ {
    عرف أس: أسـاس؛
    أس.س = 5؛
    مـتم.طـرفية.اطبع("%d\ج"، أس.هات_ق1())؛
}

دالة اختبر_ب {
    عرف اب: ابـن؛
    اب.س = 5؛
    اب.ص = 3؛
    مـتم.طـرفية.اطبع("%d، %d، %d\ج"، اب.هات_ق1()، اب.هات_ق2()، اب.هات_ق3())؛
}

دالة اطبع_أساس(أس: سند[أسـاس]) {
    مـتم.طـرفية.اطبع("أساس: %d\ج"، أس.هات_ق1())؛
}

دالة اطبع_أساس2(أس: سند[أسـاس2]) {
    مـتم.طـرفية.اطبع("أساس2: %d\ج"، أس.هات_ق1())؛
}

دالة اختبر_ج {
    عرف أس: أسـاس؛
    عرف اب: ابـن؛
    عرف حف: حـفيد؛
    أس.س = 5؛
    اب.س = 6؛
    اب.ص = 7؛
    حف.س = 8؛
    حف.ص = 9؛
    حف.ع = 10؛
    اطبع_أساس(أس)؛
    اطبع_أساس(اب)؛
    اطبع_أساس(حف)؛
}

دالة اختبر_د {
    عرف م: أسـاس_متعدد؛
    عرف مب: ابـن_متعدد؛
    عرف مب2: ابـن_متعدد2؛
    م.س = 1؛
    م.أ = 2؛
    مب.س = 1؛
    مب.أ = 2؛
    مب2.س = 1؛
    مب2.أ = 2؛
    مـتم.طـرفية.اطبع("أساس متعدد:\ج")؛
    اطبع_أساس(م)؛
    اطبع_أساس2(م.ابن2)؛
    اطبع_أساس(مب)؛
    اطبع_أساس(مب2)؛
    اطبع_أساس2(مب2.ابن2)؛
    مـتم.طـرفية.اطبع("%d\ج"، مب2.هات_ق1())؛
    مـتم.طـرفية.اطبع("%d\ج"، مب2.ابن2.هات_ق1())؛
}

اختبر_أ()؛
اختبر_ب()؛
اختبر_ج()؛
اختبر_د()؛
