// يوضح هذا المثال استخدام المبدل `@طبعات_لامشتركة` لبناء مولد استعلامات بسيط على غرار أدوات الربط الكائني العلائقي (ORM).
//
// `استعلام` صنف قالب يستقبل اسم جدول. تستقبل عمليته `حيثما` شرطا على شكل شبم، وتحوله إلى جملة SQL where وقت
// الترجمة (داخل عبارة `تمهيد`)، ثم تخزن النتيجة في طبعة القالب نفسها كثابت اسمه `الشرط`. بعد ذلك تطبع الدالة
// `اختر` جملة SQL مستخدمةً ذلك الثابت.
//
// بما أن الشرط يُخزَّن في طبعة القالب نفسها، فإن متغيرين من النوع `استعلام["مستخدمون"]` سيتشاركان الشرط نفسه لو
// تشاركا الطبعة نفسها. يجعل المبدل `@طبعات_لامشتركة` كل استخدام لـ `استعلام` ينشئ طبعة جديدة، فيحصل كل متغير على شرطه الخاص.

اشمل "مـتم/طـرفية"؛
اشمل "مـتم/نـظام"؛
اشمل "مـتم/نـص"؛
اشمل "مـتم/مـعجم"؛
اشمل "مـتم/سندات"؛
اشمل "المترجم"؛

استخدم مـتم؛
استخدم الـقلب.أسـاسيات؛
استخدم الـقلب.شـبم؛
عرف سـندنا_لعقدة: لقب سـندنا[الـقلب.شـبم.عـقدة]؛

// يرجع نص معرف أو قيمة حرفية.
دالة هات_نص_العقدة (كائن: سند[عـقدة]): نـص {
    إذا أمشتق_من[كائن، مـعرف] {
        أرجع نـص(مثل_سندا[كائن، مـعرف].القيمة.القيمة.صوان)؛
    } وإلا إذا أمشتق_من[كائن، نـص_حرفي] {
        أرجع نـص("'") + مثل_سندا[كائن، نـص_حرفي].القيمة.القيمة + نـص("'")؛
    } وإلا إذا أمشتق_من[كائن، صـحيح_حرفي] {
        أرجع نـص(مثل_سندا[كائن، صـحيح_حرفي].القيمة.القيمة.صوان)؛
    }
    نـظام.فشل(1، "هات_نص_العقدة: عقدة غير مدعومة.\ج")؛
    أرجع نـص()؛
}

// يحول شرطا على شكل شبم مثل `الاسم == "أحمد" و العمر >= 18` إلى جملة SQL where.
دالة أنشئ_حيثما (كائن: سند[عـقدة]): نـص {
    إذا كائن~مؤشر == 0 {
        نـظام.فشل(1، "أنشئ_حيثما: الكائن معدوم.\ج")؛
    }

    إذا أمشتق_من[كائن، مـؤثر_مقارنة] {
        عرف ربط: سند[ربـط](هات_وسيطا[كائن، ربـط])؛
        عرف حاوية_معجم: سند[احـتواء_معجمي[عـقدة]](هات_وسيطا[كائن، احـتواء_معجمي[عـقدة]])؛
        متغير مؤثر: نـص = نـص(مثل_سندا[ربط.هات_عضوا("type")، نـص_بهوية].القيمة.صوان)؛
        إذا مؤثر == "==" { مؤثر = "="؛ }
        أرجع هات_نص_العقدة(حاوية_معجم.هات_عنصرا("first")) + نـص(" ") + مؤثر + نـص(" ")
            + هات_نص_العقدة(حاوية_معجم.هات_عنصرا("second"))؛
    } وإلا إذا أمشتق_من[كائن، مـؤثر_منطقي] {
        عرف ربط: سند[ربـط](هات_وسيطا[كائن، ربـط])؛
        عرف حاوية_معجم: سند[احـتواء_معجمي[عـقدة]](هات_وسيطا[كائن، احـتواء_معجمي[عـقدة]])؛
        متغير مؤثر: نـص = نـص(مثل_سندا[ربط.هات_عضوا("type")، نـص_بهوية].القيمة.صوان)؛
        إذا مؤثر == "and" أو مؤثر == "&&" { مؤثر = "AND"؛ } وإلا إذا مؤثر == "or" أو مؤثر == "||" { مؤثر = "OR"؛ }
        أرجع أنشئ_حيثما(حاوية_معجم.هات_عنصرا("first")) + نـص(" ") + مؤثر + نـص(" ")
            + أنشئ_حيثما(حاوية_معجم.هات_عنصرا("second"))؛
    } وإلا إذا أمشتق_من[كائن، قـوس] {
        عرف حاوية_معجم: سند[احـتواء_معجمي[عـقدة]](هات_وسيطا[كائن، احـتواء_معجمي[عـقدة]])؛
        أرجع نـص("(") + أنشئ_حيثما(حاوية_معجم.هات_عنصرا("operand")) + نـص(")")؛
    }
    نـظام.فشل(1، "أنشئ_حيثما: شرط غير مدعوم.\ج")؛
    أرجع نـص()؛
}

// يخزن جملة where المعطاة على شكل `عرف الشرط: "<الجملة>"` في متن الصنف الذي تنتمي إليه الدالة التي تجري معالجتها
// التمهيدية حاليا.
دالة خزن_الشرط (جملة: نـص) {
    // البحث عن الصنف الذي يحتوي الدالة التي تجري معالجتها التمهيدية.
    عرف عقدة_ما: سند[عـقدة](نـبم.مدير_شبم.هات_مالك_عبارة_التمهيد_الحالية())؛
    بينما عقدة_ما~مؤشر != 0 و !أمشتق_من[عقدة_ما، نـبم.شـبم.صـنف_مستخدم] {
        عقدة_ما~عطل_التتبع = عقدة_ما.المالك؛
    }
    إذا عقدة_ما~مؤشر == 0 {
        نـظام.فشل(1، "خزن_الشرط: لسنا داخل صنف.\ج")؛
    }

    // بناء التعريف.
    عرف تعريف: سـندنا_لعقدة؛
    إذا !نـبم.مدير_شبم.أنشئ_شبم(
        شبم { عرف الشرط: جملة_sql }،
        مـعجم[نـص، سند[عـقدة]]().حدد(نـص("جملة_sql")، نـص_حرفي(جملة.صوان))،
        تعريف
    ) {
        نـظام.فشل(1، "فشل بناء تعريف الشرط.\ج")؛
    }

    // إضافة التعريف إلى متن الصنف. لاحظ أنه لا يمكن استخدام `ضمن` هنا لأنها تُطبَّق فور إعراب الشبم الحرفي، وليس
    // عند حشر الشبم.
    عرف حاوية_الصنف: سند[احـتواء_معجمي[عـقدة]](هات_وسيطا[عقدة_ما، احـتواء_معجمي[عـقدة]])؛
    عرف المتن: سند[احـتواء_مرن[عـقدة]](
        هات_وسيطا[حاوية_الصنف.هات_عنصرا("body")، احـتواء_مرن[عـقدة]]
    )؛
    متغير فهرس: صحيح = -1؛
    // ناتج أنشئ_شبم نطاق يحتوي التعريف.
    عرف حاوية_التعريف: سند[احـتواء[عـقدة]](هات_وسيطا[تعريف.كائن، احـتواء[عـقدة]])؛
    إذا !نـبم.مدير_شبم.أضف_عنصرا_قابلا_للدمج(حاوية_التعريف.هات_عنصرا(0)، المتن، فهرس) {
        نـظام.فشل(1، "فشل تخزين الشرط.\ج")؛
    }
}

@طبعات_لامشتركة صنف استعلام [الجدول: محارف] {
    عملية [الشرط: شبم] هذا.حيثما: سند[هذا_الصنف] {
        تمهيد {
            خزن_الشرط(أنشئ_حيثما(الشرط~شبم))؛
        }
        أرجع هذا؛
    }

    @عضو دالة اختر (هذا: سند[هذا_الصنف]) {
        طـرفية.اطبع("SELECT * FROM %s WHERE %s\ج"، الجدول، الشرط)؛
    }
}

دالة اختبر {
    متغير س1: استعلام["users"]؛
    س1.حيثما[الاسم == "John.Doe"].اختر()؛

    متغير س2: استعلام["users"]؛
    س2.حيثما[العمر >= 18 و (البلد == "SA" أو البلد == "AE")].اختر()؛

    // ما زال س1 يحتفظ بشرطه الخاص.
    س1.اختر()؛

    // مع متغيرات مؤقتة
    استعلام["users"]().حيثما[الاسم == "John.Doe"].اختر()؛
    استعلام["users"]().حيثما[العمر >= 18 و (البلد == "SA" أو البلد == "AE")].اختر()؛
}
اختبر()؛
