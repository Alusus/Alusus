import "Srl/Console";
import "closure";

use Srl.Console;

func runClosure (c: closure (Int):Int) {
    var r: Int = c(5);
    print("runClosure: %d\n", r);
}

func prepareClosure (): (closure (Int):Int) {
    var i: Int = 6;
    return closure (j: Int): Int {
        print("prepareClosure: %d, %d\n", j, i);
        return i;
    };
}

func test {
    var c: closure(Int):Int = prepareClosure();
    runClosure(c);
}
test();
