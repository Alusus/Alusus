  عرّف عربي2: "نص";
  def عربي3: لقب other;
  استخدم other؛
};

// Modifiers.
def modifiers1: {
  @public def p1: 5;
  @public @static def p2: 6;
  @attr(1) def p3: 7;
  @attr[1] def p4: 8;
  @attr(name: "value", count: 2) def p5: 9;
  @first @second(x) @third[y] def p6: 10;
  def p7: 11 @<trailing;
  def p8: 12 @<trailing(1) @<other[2];
