// Operators at every precedence level.
def operators141: {
  assign = value;
  addAssign += 1;
  subAssign -= 2;
  mulAssign *= 3;
  divAssign /= 4;
  arabicDivAssign ÷= 4;
  modAssign %= 5;
  andAssign &= mask;
  orAssign |= flag;
  xorAssign $= bits;
  shlAssign <<= 2;
  shrAssign >>= 3;

  result = a + b - c * d / e % f;
  arabicDiv = a ÷ b;
  bitwise = a | b $ c & d << 2 >> 1;
  comparison1 = a == b;
  comparison2 = a != b;
  comparison3 = a < b;
  comparison4 = a > b;
  comparison5 = a <= b;
  comparison6 = a >= b;
  logical1 = a || b && c $$ d;
  logical2 = a or b and c xor d;
  logical3 = a nor b xnor c nand d;
  logical4 = a أو b و c أو_حصرا d;
  logical5 = a وليس b وليس_حصرا c أو_ليس d;

  prefix1 = ++counter;
  prefix2 = --counter;
  prefix3 = +value;
  prefix4 = -value;
  prefix5 = !flag;
  prefix6 = !!flag;
  prefix7 = not flag;
  prefix8 = ليس flag;
  prefix9 = ...args;
  postfix1 = counter++;
  postfix2 = counter--;
  both = --counter++;

  link1 = obj.member.subMember;
  link2 = ptr->member;
  link3 = obj.>member;
  link4 = obj<.member;
  lowLink1 = (a, b) => c;
  lowLink2 = 1..10;
  lowLink3 = start..>finish;
  lowLink4 = a <.> b;
  lowerLink1 = key: value;
  lowerLink2 = key :> value;
  lowerLink3 = key <: value;
  lowestLink1 = a :: b;
  lowestLink2 = a ::> b;
  lowestLink3 = a <:: b;
  lowestLink4 = item in collection;
  lowestLink5 = item في collection;

  conditional1 = a > b ? a;
  conditional2 = a < b ؟ b;
  continued = a + b \;

  mixed = (a + b) * (c - d) / -(e % f) + g.h(i, j)[k] - ++l.m;
  nested = ((((a + b) * c) - d) / e);
  chained = a.b.c(d).e[f].g(h)(i)[j][k];
};

