  comparison4 = a > b;
  comparison5 = a <= b;
  comparison6 = a >= b;
  logical1 = a || b && c $$ d;
  logical2 = a or b and c xor d;
  logical3 = a nor b xnor c nand d;
  logical4 = a أو b و c أو_حصرا d;
  logical5 = a وليس b وليس_حصرا c أو_ليس d;

  prefix1 = ++counter;
  prefix2 = --counter;
  prefix3 = +value;
  prefix4 = -value;
  prefix5 = !flag;
  prefix6 = !!flag;
  prefix7 = not flag;
  prefix8 = ليس flag;
