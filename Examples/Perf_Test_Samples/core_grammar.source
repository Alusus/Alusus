  modAssign %= 5;
  andAssign &= mask;
  orAssign |= flag;
  xorAssign $= bits;
  shlAssign <<= 2;
  shrAssign >>= 3;

  result = a + b - c * d / e % f;
  arabicDiv = a ÷ b;
  bitwise = a | b $ c & d << 2 >> 1;
  comparison1 = a == b;
  comparison2 = a != b;
