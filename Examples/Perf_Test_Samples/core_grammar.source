  link4 = obj<.member;
  lowLink1 = (a, b) => c;
  lowLink2 = 1..10;
  lowLink3 = start..>finish;
  lowLink4 = a <.> b;
  lowerLink1 = key: value;
  lowerLink2 = key :> value;
  lowerLink3 = key <: value;
  lowestLink1 = a :: b;
  lowestLink2 = a ::> b;
  lowestLink3 = a <:: b;
  lowestLink4 = item in collection;
  lowestLink5 = item في collection;

  conditional1 = a > b ? a;
  conditional2 = a < b ؟ b;
  continued = a + b \;

  mixed = (a + b) * (c - d) / -(e % f) + g.h(i, j)[k] - ++l.m;
  nested = ((((a + b) * c) - d) / e);
  chained = a.b.c(d).e[f].g(h)(i)[j][k];
};

