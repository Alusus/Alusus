  def unsignedInt: 42u;
  def unsignedInt2: 42U;
  def sizedInt: 42i32;
  def sizedInt2: 42I64;
  def sizedUnsignedInt: 42u16;
  def binInt: 0b101101;
  def binInt2: 0B11110000u8;
  def octInt: 0o755;
  def octInt2: 0O17;
  def hexInt: 0hFF00FF;
  def hexInt2: 0xdeadBEEF;
  def hexInt3: 0X7fffi64;
  def float1: 3.14159;
  def float2: 2.5f;
  def float3: 2.5f64;
  def float4: 6.02e23;
  def float5: 1.5E-10f32;
  def float6: 7e+3;
  def float7: 9f;
  def char1: 'a';
  def char2: '\n';
  def char3: '\'';
  def char4: '"';
  def char5: '\\';
  def str1: "Hello World";
  def str2: "Tab\tNewline\nReturn\rFeed\fQuote\"Backslash\\";
  def str3: "Hex \h41\x42 Unicode ⛔ Wide \U0001F600";
  def str4: "Part one, " "part two, "
    "part three.";
  def str5: "Single 'quotes' inside";
  def arabicInt: 15ط;
  def arabicInt2: 15ص32;
  def arabicBin: 0ن1011;
  def arabicOct: 0م777;
  def arabicFloat: 1.25ع;
  def arabicStr: "مرحبا يا عالم \ج \ت \ر";
};

// Operators at every precedence level.
def operators8: {
  assign = value;
  addAssign += 1;
  subAssign -= 2;
  mulAssign *= 3;
  divAssign /= 4;
  arabicDivAssign ÷= 4;
  modAssign %= 5;
  andAssign &= mask;
  orAssign |= flag;
  xorAssign $= bits;
  shlAssign <<= 2;
  shrAssign >>= 3;

  result = a + b - c * d / e % f;
  arabicDiv = a ÷ b;
  bitwise = a | b $ c & d << 2 >> 1;
  comparison1 = a == b;
  comparison2 = a != b;
  comparison3 = a < b;
  comparison4 = a > b;
  comparison5 = a <= b;
  comparison6 = a >= b;
  logical1 = a || b && c $$ d;
  logical2 = a or b and c xor d;
  logical3 = a nor b xnor c nand d;
  logical4 = a أو b و c أو_حصرا d;
  logical5 = a وليس b وليس_حصرا c أو_ليس d;

  prefix1 = ++counter;
  prefix2 = --counter;
  prefix3 = +value;
  prefix4 = -value;
  prefix5 = !flag;
  prefix6 = !!flag;
  prefix7 = not flag;
  prefix8 = ليس flag;
  prefix9 = ...args;
  postfix1 = counter++;
  postfix2 = counter--;
  both = --counter++;

  link1 = obj.member.subMember;
  link2 = ptr->member;
  link3 = obj.>member;
  link4 = obj<.member;
  lowLink1 = (a, b) => c;
  lowLink2 = 1..10;
  lowLink3 = start..>finish;
  lowLink4 = a <.> b;
  lowerLink1 = key: value;
  lowerLink2 = key :> value;
  lowerLink3 = key <: value;
  lowestLink1 = a :: b;
  lowestLink2 = a ::> b;
  lowestLink3 = a <:: b;
  lowestLink4 = item in collection;
  lowestLink5 = item في collection;

  conditional1 = a > b ? a;
  conditional2 = a < b ؟ b;
  continued = a + b \;

  mixed = (a + b) * (c - d) / -(e % f) + g.h(i, j)[k] - ++l.m;
  nested = ((((a + b) * c) - d) / e);
  chained = a.b.c(d).e[f].g(h)(i)[j][k];
};

// Calls, brackets, lists and maps.
def calls8: {
  func();
  func(1);
  func(1, 2, 3);
  func[];
  func[Int];
  func[Int, Float](a, b);
  obj.method(arg1, arg2).other[index](more);
  empty1 = ();
  empty2 = [];
  bracket1 = (a);
  bracket2 = [a];
  list1 = (1, 2, 3, 4, 5);
  list2 = (,);
  list3 = (,1);
  list4 = (1,,3);
  list5 = (1, 2, 3,);
  list6 = (,,1, 2,, 4,,);
  list7 = [1, 2, 3];
  arabicList = (1، 2، 3);
  map1 = (a: 1, b: 2, c: 3);
  map2 = (name: "value", count: 10, nested: (x: 1, y: 2));
  tilde1 = value~(expr);
  tilde2 = a.b~(c + d).e;
  tilde3 = obj~(1, 2)~(3);
};

// Commands.
def commands8: {
  do "string";
  do 42;
  do identifier;
  do (s: 10);
  do [s: 10];
  do {
    inner = 1;
    inner += 2;
    do {
      deepest = inner * 3;
    };
  };
  def constant: 10;
  def expr: a + b * c;
  def func: (a: Int, b: Int) => Int;
  def block: {
    x = 1;
    y = 2;
    def innerBlock: {
      z = x + y;
    };
  };
  def aliased: alias other.member;
  def aliased2: alias a.b.c;
  use other;
  use other.member;
  عرف عربي: 5;
  عرّف عربي2: "نص";
  def عربي3: لقب other;
  استخدم other؛
};

// Modifiers.
def modifiers8: {
  @public def p1: 5;
  @public @static def p2: 6;
  @attr(1) def p3: 7;
  @attr[1] def p4: 8;
  @attr(name: "value", count: 2) def p5: 9;
  @first @second(x) @third[y] def p6: 10;
  def p7: 11 @<trailing;
  def p8: 12 @<trailing(1) @<other[2];
  do "leading" ;
  @mod do "with modifier";
  @mod a = 1 + 2;
  a = 1 + 2 @<mod;
  @mod(1) @other[2] obj.method(arg) @<trailing(3);
};

// Root level statements.
do "root statement 8";
do {
  rootBlock8 = 1;
  rootBlock8 += value * 2 - other.call(1, (a: 2, b: 3));
};
@marker def rootDef8: (first: 1, second: "two", third: 3.0) @<trailing;
def rootAlias8: alias literals8.str1;
def rootFunc8: (x: Int, y: Int) => (
  x * x + y * y > 100 ? x : y
);
def rootSet8: {
  def a: 1;
  def b: a + 1;
  def c: { def d: b * 2; };
}؛
def rootCompact8:{a=1;b=a+2*3;c=(a,b);d=c.e(f)[g];do{h=i;};};
