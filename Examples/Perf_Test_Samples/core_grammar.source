  @mod do "with modifier";
  @mod a = 1 + 2;
  a = 1 + 2 @<mod;
  @mod(1) @other[2] obj.method(arg) @<trailing(3);
};

// Root level statements.
do "root statement 1";
do {
  rootBlock1 = 1;
  rootBlock1 += value * 2 - other.call(1, (a: 2, b: 3));
};
@marker def rootDef1: (first: 1, second: "two", third: 3.0) @<trailing;
def rootAlias1: alias literals1.str1;
def rootFunc1: (x: Int, y: Int) => (
