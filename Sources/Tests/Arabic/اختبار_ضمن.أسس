اشمل "مـتم/طـرفية.أسس"؛

وحدة خارجية
{
  وحدة داخلية
  {
    عرف أ: 1؛
  }
  صنف صنف_أ
  {
    عرف س: 10؛
  }
}

// أمر واحد ومعرّف واحد.
ضمن خارجية عرف ب: 2؛

// أمر واحد ومسار.
ضمن خارجية.داخلية عرف ج: 3؛

// مجموعة أوامر.
ضمن خارجية.داخلية {
  عرف د: 4؛
  دالة مرحبا
  {
    مـتم.طـرفية.اطبع("خارجية.داخلية.مرحبا\ج")؛
  }
}

// مجموعة أوامر تضاف لصنف.
ضمن خارجية.صنف_أ {
  عرف ص: 20؛
  دالة مجموع (): صـحيح
  {
    أرجع س + ص؛
  }
}

// ضمن متداخلة والمسار يبدأ من الجذر.
ضمن خارجية {
  ضمن خارجية.داخلية عرف ه: 5؛
  عرف ي: 6؛
}

مـتم.طـرفية.اطبع("%d %d %d %d %d %d\ج"، خارجية.ب، خارجية.داخلية.أ، خارجية.داخلية.ج، خارجية.داخلية.د، خارجية.داخلية.ه، خارجية.ي)؛
خارجية.داخلية.مرحبا()؛
مـتم.طـرفية.اطبع("%d\ج"، خارجية.صنف_أ.مجموع())؛

// دمج التعريفات عبر ضمن.
ضمن خارجية {
  @دمج عرف داخلية: وحدة
  {
    عرف ز: 7؛
  }
}
مـتم.طـرفية.اطبع("%d\ج"، خارجية.داخلية.ز)؛
