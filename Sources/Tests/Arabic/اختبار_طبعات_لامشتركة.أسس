// نسخ القالب العادي تُشارَك عند تطابق المعطيات، لذا يتشارك العداد المشترك.
صنف قالب_عادي [ص: صنف] {
  @مشترك عرف عدد: صحيح؛

  @عضو دالة زد (هذا: سند[هذا_الصنف]) {
    عدد = عدد + 1؛
    اطبع("Shared count: %d\ج"، عدد)؛
  }؛
}؛

// كل استخدام لقالب طبعاته لا مشتركة ينشئ نسخة جديدة حتى لو تطابقت المعطيات.
@طبعات_لامشتركة صنف غـير_مشترك [ص: صنف] {
  @مشترك عرف عدد: صحيح؛

  @عضو دالة زد (هذا: سند[هذا_الصنف]) {
    عدد = عدد + 1؛
    اطبع("Unshared count: %d\ج"، عدد)؛
  }؛
}؛

دالة دالة_مشتركة [ص: صنف] (ق: ص) {
  تمهيد {
    اطبع("sharedFunc called\ج")؛
  }
}؛

@طبعات_لامشتركة دالة دالة_غير_مشتركة [ص: صنف] (ق: ص) {
  تمهيد {
    اطبع("unsharedFunc called\ج")؛
  }
}؛

