    طـرفية.اطبع("%d، %d\ج"، م، م2)؛

    عرف خ: خارجي؛
    عرف خد: خ.د~صنف؛
    خ.ج = 257؛
    خد.ع = 258؛
    طـرفية.اطبع("%d، %d\ج"، خ.ج~مثل[صحيح]، خد.ع~مثل[صحيح])؛
}
اختبر()؛

