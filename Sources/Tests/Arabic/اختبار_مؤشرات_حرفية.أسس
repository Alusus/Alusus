اشمل "مـتم/طـرفية"؛
اشمل "مـتم/نـص"؛
استخدم مـتم؛

دالة استلم_محارف(م: مؤشر[مصفوفة[طبيعي[8]]]) {
    طـرفية.اطبع("مؤشر: %s\ج"، م)؛
}

دالة استلم_محارف_حرفية(م: مؤشر_حرفي[مصفوفة[طبيعي[8]]]) {
    طـرفية.اطبع("مؤشر حرفي: %s\ج"، م)؛
}

دالة استلم_نصا(ن: نـص) {
    طـرفية.اطبع("نـص: %s\ج"، ن.صوان)؛
}

دالة هات_نصا(): نـص {
    ارجع "نص مرجع حرفي"؛
}

// النصوص الحرفية مؤشرات حرفية يمكن تحويلها ضمنيا إلى مؤشرات عادية.
استلم_محارف("حرفي إلى مؤشر")؛
استلم_محارف_حرفية("حرفي إلى مؤشر حرفي")؛

// يمكن تحويل المؤشرات العادية إلى مؤشرات حرفية صراحة.
متغير م: مؤشر[مصفوفة[طبيعي[8]]] = "مؤشر عادي"؛
استلم_محارف_حرفية(م~مثل[مؤشر_حرفي[مصفوفة[طبيعي[8]]]])؛

// تحويل المؤشرات الحرفية إلى نـص تلقائيا.
استلم_نصا("حرفي إلى نـص")؛
طـرفية.اطبع("%s\ج"، هات_نصا().صوان)؛
متغير ن: نـص = "قيمة ابتدائية حرفية"؛
طـرفية.اطبع("%s\ج"، ن.صوان)؛
ن = "إسناد من حرفي"؛
طـرفية.اطبع("%s\ج"، ن.صوان)؛

// يمكن تعريف محولات مخصصة على المؤشر الحرفي مباشرة.
صنف غلاف {
    عرف قيمة: صحيح؛
}
ضمن مؤشر_حرفي[مصفوفة[طبيعي[8]]] عملية هذا~مثل[غلاف] {
    @مشترك عرف غ: غلاف؛
    غ.قيمة = 7؛
    ارجع غ؛
}
دالة استلم_غلافا(غ: غلاف) {
    طـرفية.اطبع("غلاف: %d\ج"، غ.قيمة)؛
}
استلم_غلافا("أي نص حرفي")؛
