اشمل "مـتم/طـرفية.أسس"؛

استخدم مـتم.طـرفية؛

صنف عـميق {
  عرف ع: صحيح؛
}

صنف وسـط {
  @حقنة عرف عم: عـميق؛
  عرف س: صحيح؛
  @لا_يحقن عرف مخفي: صحيح؛
  @لا_يحقن متغير مخفي2: صحيح؛
  @لا_يحقن عملية هذا.خصلة_مخفية: صحيح { أرجع 5؛ }
}

متغير ع: صحيح = 100؛
متغير مخفي: صحيح = 200؛
متغير مخفي2: صحيح = 300؛
دالة خصلة_مخفية (): صحيح { أرجع 400؛ }

صنف مـحدود {
  @حقنة[1] عرف وس: وسـط؛
  عملية هذا.اختبر() {
    س = 1؛
    وس.ع = 2؛
    وس.مخفي = 3؛
    اطبع("س = %d، ع = %d، مخفي = %d، مخفي2 = %d، خصلة_مخفية = %d\ج"، س، ع، مخفي، مخفي2، خصلة_مخفية())؛
    اطبع("وس.ع = %d، وس.مخفي = %d، وس.خصلة_مخفية = %d\ج"، وس.ع، وس.مخفي، وس.خصلة_مخفية)؛
  }
}

صنف مـحدود2 {
  @حقنة[2] متغير وس: وسـط؛
  عملية هذا.اختبر() {
    ع = 6؛
    اطبع("ع = %d\ج"، ع)؛
  }
}

عرف م: مـحدود؛
م.اختبر()؛
عرف م2: مـحدود2؛
م2.اختبر()؛
