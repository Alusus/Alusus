اشمل "مـتم/طـرفية"؛
استخدم مـتم؛

صنف أول {
    عرف ق: صحيح؛
    عملية هذا~مثل[صحيح] ارجع هذا.ق؛
}

// تظهر المحولات المخصصة للعضو المحقون إذا كان هو العضو الأول.
صنف ثان {
    @حقنة متغير ع: أول؛
}

// يمكن إيجاد المحولات عبر عدة مستويات من الحقن.
صنف ثالث {
    @حقنة متغير ع: ثان؛
    عرف س: صحيح؛
}

// محول يرجع نوعا يحتاج إلى تحويل آخر للوصول إلى الصنف المطلوب.
صنف صغير {
    عرف ق: صحيح[32]؛
    عملية هذا~مثل[صحيح[32]] ارجع هذا.ق؛
}

صنف غلاف {
    @حقنة متغير ص: صغير؛
}

دالة اطبع_صحيحا(ق: صحيح) {
    طـرفية.اطبع("صحيح: %d\ج"، ق)؛
}

دالة اطبع_صحيحا_طويلا(ق: صحيح[64]) {
    طـرفية.اطبع("صحيح[64]: %ld\ج"، ق)؛
}

دالة اختبر {
    متغير كثان: ثان؛
    كثان.ق = 7؛
    اطبع_صحيحا(كثان)؛

    متغير كثالث: ثالث؛
    كثالث.ق = 8؛
    كثالث.س = 9؛
    اطبع_صحيحا(كثالث)؛
    طـرفية.اطبع("س: %d\ج"، كثالث.س)؛

    متغير غ: غلاف؛
    غ.ق = 10؛
    اطبع_صحيحا_طويلا(غ)؛
}

اختبر()؛
