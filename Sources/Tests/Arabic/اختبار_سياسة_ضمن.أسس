اشمل "مـتم/طـرفية.أسس"؛
اشمل "مـتم/مـعجم"؛
اشمل "مـتم/نـص"؛
اشمل "المترجم"؛

استخدم مـتم؛

// ننشئ وحدة عبر أمر تمهيد، فلا تكون موجودة وقت تحليل أوامر `ضمن` أدناه.
ماكرو عرّف_وحدة [اسم] {
  تمهيد {
    نـبم.مدير_شبم.احشر_شبم(شبم { وحدة اسم { عرف أساس: 1؛ } }، مـعجم[نـص، سند[الـقلب.شـبم.عـقدة]]())؛
  }
}

// داخل الوحدة لا تُوسَّع الماكروات إلا أثناء التمهيد، أي بعد تحليل أوامر `ضمن`.
وحدة خارجية {
  عرّف_وحدة[تلقائية]؛
  عرّف_وحدة[مؤجلة]؛

  // السياسة الافتراضية (تلقائي): الهدف غير موجود وقت التحليل، فيطبق الأمر أثناء التمهيد.
  ضمن تلقائية عرف أ: 2؛

  // مؤجل: لا يبحث عن الهدف أصلاً وقت التحليل.
  @مؤجل ضمن مؤجلة {
    عرف ب: 3؛
    دالة مرحبا
    {
      مـتم.طـرفية.اطبع("مؤجلة.مرحبا\ج")؛
    }
  }
}

// الأوامر الموجهة لنطاق موجود لا تتأثر بالسياسة.
وحدة موجودة {}
@مؤجل ضمن موجودة عرف ج: 4؛
@فوري ضمن موجودة عرف د: 5؛

مـتم.طـرفية.اطبع("%d %d\ج"، خارجية.تلقائية.أساس، خارجية.تلقائية.أ)؛
مـتم.طـرفية.اطبع("%d %d\ج"، خارجية.مؤجلة.أساس، خارجية.مؤجلة.ب)؛
خارجية.مؤجلة.مرحبا()؛
مـتم.طـرفية.اطبع("%d %d\ج"، موجودة.ج، موجودة.د)؛
