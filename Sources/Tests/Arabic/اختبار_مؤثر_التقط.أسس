اشمل "مـتم/طـرفية"؛
استخدم مـتم؛

دالة اطبع (ص: صحيح) {
    طـرفية.اطبع("اطبع(صحيح): %d\ج"، ص)؛
}

دالة اطبع (ن: مـؤشر_محارف) {
    طـرفية.اطبع("اطبع(مؤشر_محارف): %s\ج"، ن)؛
}

متغير مد1: مؤشر[دالة (صحيح)] = اطبع~التقط[دالة (صحيح)]~مؤشر؛
مد1(5)؛
متغير مد2: مؤشر[دالة (مـؤشر_محارف)] = اطبع~التقط[دالة (مـؤشر_محارف)]~مؤشر؛
مد2("مرحبا")؛

صنف نـقطة {
    عرف س: صحيح؛

    عملية هذا.انقل (ف: صحيح) {
        هذا.س += ف؛
    }

    عملية هذا.انقل (ف: صحيح، ق: صحيح) {
        هذا.س += ف * ق؛
    }

    عملية هذا.الإحداثي_س: صحيح {
        أرجع هذا.س؛
    }
}

متغير ن: نـقطة؛
ن.س = 1؛
متغير من: مؤشر[دالة (سند[نـقطة]، صحيح)] = نـقطة.انقل~التقط[دالة (سند[نـقطة]، صحيح)]~مؤشر؛
من(ن، 2)؛
متغير مس: مؤشر[دالة (سند[نـقطة]): صحيح] = نـقطة.الإحداثي_س~التقط[دالة (سند[نـقطة]): صحيح]~مؤشر؛
طـرفية.اطبع("ن.س: %d\ج"، مس(ن))؛

