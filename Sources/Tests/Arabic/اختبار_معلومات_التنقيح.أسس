اشمل "مـتم/متم"؛
اشمل "المترجم"؛

صنف نقطة
{
  عرف س: صـحيح؛
  عرف ص: صـحيح؛
}؛

عرف رئـيسي: وحدة
{
  دالة جمع (أ: صـحيح، ب: صـحيح): صـحيح
  {
    أرجع أ + ب؛
  }؛

  دالة احسب (ن: صـحيح، ق: سند[نقطة]): صـحيح
  {
    متغير ناتج: صـحيح = 0؛
    إذا ن > 0 {
      متغير ت: صـحيح = ن * 2؛
      ناتج = ناتج + ت؛
    }
    وإلا {
      متغير ت: صـحيح = ن * 3؛
      ناتج = ناتج + ت؛
    }؛
    أرجع جمع(ناتج، ن)؛
  }؛
}؛

