اشمل "مـتم/طـرفية"؛
استخدم مـتم؛

// الاستدعاء على صنف، مثل `صنف(...)`، قد يطابق مُنشئا (`~هيئ`)، أو عملية `()` على الصنف نفسه (`هذا_الصنف`)، أو عملية
// `()` على كائن (`هذا`) وهي تستلم الكائن كأول معطى.
صنف كل {
    عرف نوع: صحيح؛
    عرف ق: صحيح؛

    عملية هذا~هيئ(أ: صحيح، ب: صحيح، ج: صحيح) {
        هذا.نوع = 1؛
        هذا.ق = أ + ب + ج؛
    }

    عملية هذا(ي: صحيح): صحيح {
        ارجع هذا.ق + ي؛
    }

    عملية هذا_الصنف(ن: صحيح): سند[كل] {
        @مشترك عرف أ: كل(0، 0، 0)؛
        أ.نوع = 3؛
        أ.ق = ن؛
        ارجع أ؛
    }
}

دالة اختبر_كل {
    طـرفية.اطبع("اختبر_كل\ج")؛

    // المنشئ.
    طـرفية.اطبع("منشئ: %d، %d\ج"، كل(1، 2، 3).نوع، كل(1، 2، 3).ق)؛

    // العملية على الصنف نفسه.
    طـرفية.اطبع("عملية الصنف: %d، %d\ج"، كل(7).نوع، كل(7).ق)؛

    // العملية على كائن، وهي تستلم الكائن كأول معطى.
    عرف س: كل(1، 2، 3)؛
    طـرفية.اطبع("عملية الكائن: %d\ج"، كل(س، 10))؛
    طـرفية.اطبع("عملية الكائن: %d\ج"، س(10))؛
}
اختبر_كل()؛

طـرفية.اطبع("\ج")؛

// تفوز المطابقة الأفضل بغض النظر عن نوع العملية.
صنف اختيار {
    عرف نوع: صحيح؛

    عملية هذا~هيئ(ن: صحيح[32]) {
        هذا.نوع = 1؛
    }

    عملية هذا_الصنف(ن: صحيح[64]): سند[اختيار] {
        @مشترك عرف خ: اختيار(0)؛
        خ.نوع = 2؛
        ارجع خ؛
    }
}

دالة اختبر_أفضل_مطابقة {
    طـرفية.اطبع("اختبر_أفضل_مطابقة\ج")؛
    عرف قصير: صحيح[32]؛
    عرف طويل: صحيح[64]؛
    قصير = 1؛
    طويل = 1؛

    // مطابقة تامة للمُنشئ، وترقية للعملية على الصنف.
    طـرفية.اطبع("%d\ج"، اختيار(قصير).نوع)؛
    // مطابقة تامة للعملية على الصنف.
    طـرفية.اطبع("%d\ج"، اختيار(طويل).نوع)؛
}
اختبر_أفضل_مطابقة()؛

طـرفية.اطبع("\ج")؛

// تفوز العملية `()` إذا تطابق الاثنان في المستوى نفسه.
صنف تعادل {
    عرف نوع: صحيح؛

    عملية هذا~هيئ(ن: صحيح[32]) {
        هذا.نوع = 1؛
    }

    عملية هذا_الصنف(ن: صحيح[32]): سند[تعادل] {
        @مشترك عرف خ: تعادل(0)؛
        خ.نوع = 2؛
        ارجع خ؛
    }
}

دالة اختبر_تعادل {
    طـرفية.اطبع("اختبر_تعادل\ج")؛
    عرف ن: صحيح[32]؛
    ن = 5؛
    طـرفية.اطبع("%d\ج"، تعادل(ن).نوع)؛
}
اختبر_تعادل()؛

طـرفية.اطبع("\ج")؛

// وجود محول إلى الصنف يجعل أول معطى للعملية `()` على كائن قابلا للتحويل، لكن المُنشئ هو الأفضل هنا لأنه لا يحتاج
// إلى تحويل.
صنف نص {
    عرف نوع: صحيح؛

    عملية هذا~هيئ(م: مؤشر[مصفوفة[طبيعي[8]]]، ن: صحيح) {
        هذا.نوع = 1؛
    }

    // مطلوب لأن المحول أدناه يرجع نص بالقيمة.
    عملية هذا~هيئ(م: سند[نص]) {
        هذا.نوع = م.نوع؛
    }

    عملية هذا(ي: صحيح): صحيح {
        ارجع 100 + ي؛
    }
}

ضمن مؤشر[مصفوفة[طبيعي[8]]] عملية هذا~مثل[نص] {
    ارجع نص(هذا، 1)؛
}

دالة تحويل_تلقائي(ق: سند[نص]) {
    طـرفية.اطبع("تحويل_تلقائي: %d\ج"، ق.نوع)؛
}

دالة اختبر_محول {
    طـرفية.اطبع("اختبر_محول\ج")؛
    متغير م: مؤشر[مصفوفة[طبيعي[8]]] = "abc"؛
    طـرفية.اطبع("%d\ج"، نص(م، 3).نوع)؛
    عرف ن: نص(م، 3)؛
    طـرفية.اطبع("%d\ج"، نص(ن، 3))؛
    تحويل_تلقائي(م)؛
}
اختبر_محول()؛
