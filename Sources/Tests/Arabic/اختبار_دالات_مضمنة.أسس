اشمل "مـتم/طـرفية"؛

استخدم مـتم.طـرفية؛

صنف نـقطة {
  عرف س: صحيح؛
  عرف ص: صحيح؛

  @مضمن @عضو دالة كبر (هذا: سند[هذا_الصنف]، م: صحيح) {
    هذا.س *= م؛
    هذا.ص *= م؛
  }

  @مضمن عملية هذا.مجموع: صحيح {
    أرجع هذا.س + هذا.ص؛
  }
}

@مضمن دالة مربع (ع: صحيح): صحيح {
  أرجع ع * ع؛
}

@مضمن دالة ضعف [ن: صنف] (ق: ن): ن {
  أرجع ق + ق؛
}

دالة ابدأ {
  عرف ن: نـقطة؛
  ن.س = 1؛
  ن.ص = 2؛
  ن.كبر(مربع(3))؛
  اطبع("ن: %d، %d\ج"، ن.س، ن.ص)؛
  اطبع("ن.مجموع: %d\ج"، ن.مجموع)؛
  اطبع("ضعف[صحيح](21): %d\ج"، ضعف[صحيح](21))؛
}

ابدأ()؛
