اشمل "مـتم/طـرفية.أسس"؛
استخدم مـتم.طـرفية؛

وحدة رئـيسي {
  صنف مـسجل {
    عرف ق: صحيح؛
    عملية هذا~هيئ() { هذا.ق = 0؛ اطبع("مـسجل~هيئ()\ج")؛ }
    عملية هذا~هيئ(ع: صحيح) { هذا.ق = ع؛ اطبع("مـسجل~هيئ(%d)\ج"، ع)؛ }
    عملية هذا = صحيح { هذا.ق = قيمة؛ اطبع("مـسجل = %d\ج"، قيمة)؛ }
  }؛

  دالة هات_عدد (): صحيح[64] { أرجع 42 }

  متغير عام_مستنتج = 5؛
  متغير عام_مسند: مـسجل = 7؛
  متغير عام_مهيأ: مـسجل(8)؛
  متغير عام_مهيأ_مستنتج :: هات_عدد()؛
  @أولوية متغير متغير_بأولوية = 3؛
  عرف عام_بعرف_قيمة: متغير 6؛
  عرف عام_بعرف_صنف: متغير مـسجل؛

  صنف حـاوية {
    متغير أ: صحيح = 3؛
    متغير ب = أ + 1؛
    متغير ج = هذا.ب * 2؛
    متغير د: مـسجل(11)؛
    متغير هـ: مـسجل = 12؛
    @مشترك متغير العدد = 10؛
    متغير الرقم = ++العدد؛
  }؛

  صنف حـاوية_بعرف {
    عرف أ: متغير 4؛
    عرف ب: متغير أ * 2؛
    عرف ج: متغير مـسجل؛
  }؛

  دالة ضاعف [ص: صنف] (ق: ص): ص {
    متغير ن = ق + ق؛
    أرجع ن؛
  }

  دالة ابدأ {
    اطبع("المتغيرات المحلية:\ج")؛
    متغير س = 5؛
    متغير ع :: س + 1؛
    متغير م: مـسجل = 9؛
    متغير ل: مـسجل(10)؛
    متغير ن = هات_عدد()؛
    اطبع("س = %d، ع = %d، م = %d، ل = %d، ن = %d\ج"، س، ع، م.ق، ل.ق، ن)؛

    اطبع("أحجام الأصناف المستنتجة:\ج")؛
    متغير واحد = 1؛
    متغير واحد_طبيعي = 1ط؛
    متغير سالب = -1؛
    متغير كبير = 5000000000؛
    متغير صغير = 5ص8؛
    اطبع(
      "واحد = %d، واحد_طبيعي = %d، سالب = %d، كبير = %d، صغير = %d، ن = %d\ج"،
      واحد~حجم، واحد_طبيعي~حجم، سالب~حجم، كبير~حجم، صغير~حجم، ن~حجم
    )؛

    اطبع("السندات (تُنسخ مع = وتُربط مع ::)\ج")؛
    عرف سن: سند[صحيح]؛
    سن~مؤشر = س~مؤشر؛
    متغير نسخة = سن؛
    نسخة = 20؛
    اطبع("س = %d، نسخة = %d\ج"، س، نسخة)؛
    متغير مربوط :: سن؛
    مربوط = 30؛
    اطبع("س = %d، مربوط = %d\ج"، س، مربوط)؛
    متغير نسخة_متغير :: س؛
    نسخة_متغير = 40؛
    اطبع("س = %d، نسخة_متغير = %d\ج"، س، نسخة_متغير)؛

    اطبع("المتغيرات العمومية:\ج")؛
    اطبع(
      "عام_مستنتج = %d، عام_مسند = %d، عام_مهيأ = %d، عام_مهيأ_مستنتج = %d، متغير_بأولوية = %d\ج"،
      عام_مستنتج، عام_مسند.ق، عام_مهيأ.ق، عام_مهيأ_مستنتج، متغير_بأولوية
    )؛

    اطبع("متغيرات الأصناف:\ج")؛
    متغير ح1: حـاوية؛
    متغير ح2: حـاوية؛
    اطبع("أ = %d، ب = %d، ج = %d، د = %d، هـ = %d\ج"، ح1.أ، ح1.ب، ح1.ج، ح1.د.ق، ح1.هـ.ق)؛
    اطبع("ح1.الرقم = %d، ح2.الرقم = %d، العدد = %d\ج"، ح1.الرقم، ح2.الرقم، حـاوية.العدد)؛

    اطبع("صيغة عرف:\ج")؛
    عرف بعرف_قيمة: متغير س + 2؛
    عرف بعرف_مربوط: متغير سن؛
    بعرف_مربوط = 50؛
    عرف بعرف_صنف: متغير صحيح[16]؛
    بعرف_صنف = 3؛
    عرف بعرف_كائن: متغير مـسجل؛
    متغير ح_ع: حـاوية_بعرف؛
    اطبع(
      "عام_بعرف_قيمة = %d، عام_بعرف_صنف = %d، بعرف_قيمة = %d، س = %d، بعرف_مربوط = %d، بعرف_صنف = %d (%d)، بعرف_كائن = %d\ج"،
      عام_بعرف_قيمة، عام_بعرف_صنف.ق، بعرف_قيمة، س، بعرف_مربوط، بعرف_صنف، بعرف_صنف~حجم، بعرف_كائن.ق
    )؛
    اطبع("ح_ع.أ = %d، ح_ع.ب = %d، ح_ع.ج = %d\ج"، ح_ع.أ، ح_ع.ب، ح_ع.ج.ق)؛

    اطبع("القوالب:\ج")؛
    اطبع("ضاعف[صحيح](21) = %d، ضاعف[صحيح[64]](50) = %d\ج"، ضاعف[صحيح](21)، ضاعف[صحيح[64]](50))؛
  }
}؛

رئـيسي.ابدأ()؛
