اطبع("خ.داخلي.جدول.هات_القيمة() = %d\ج"، خ.داخلي.جدول.هات_القيمة())؛
اطبع("خ.مربوط.هات_ر() = %d\ج"، خ.مربوط.هات_ر())؛
