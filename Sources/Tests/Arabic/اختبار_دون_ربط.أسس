اشمل "مـتم/طـرفية.أسس"؛

استخدم مـتم.طـرفية؛

صنف نـوعي {
  صنف جـدول {
    عملية (هذا: نـوعي).هات_القيمة(): صحيح {
      أرجع هذا.ق؛
    }؛
    عملية (هذا: نـوعي).هات_القيمة_زائد(ع: صحيح): صحيح {
      أرجع هذا.ق + ع؛
    }؛
  }
  @مشترك عرف جدول_مشترك: جـدول؛
  @دون_ربط @حقنة عرف جدول: سند[جـدول](جدول_مشترك)؛

  عرف ق: صحيح؛

  عملية هذا.اطبع_القيم() {
    اطبع("هذا.هات_القيمة() = %d\ج"، هذا.هات_القيمة())؛
    اطبع("هذا.جدول.هات_القيمة() = %d\ج"، هذا.جدول.هات_القيمة())؛
  }؛
}

صنف مـربوط {
  عرف ر: صحيح؛
  عملية هذا.هات_ر(): صحيح {
    أرجع هذا.ر؛
  }؛
}

صنف خـارجي {
  عرف داخلي: نـوعي؛
  عرف مربوط: مـربوط؛
}

