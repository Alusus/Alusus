اشمل "مـتم/طـرفية.أسس"؛
اشمل "مـتم/سندات.أسس"؛

استخدم مـتم؛
استخدم مـتم.طـرفية؛

صنف داخـلي {
  متغير س: صحيح؛
  عملية هذا.هات_س(): صحيح {
    أرجع هذا.س؛
  }؛
}

// عملية قراءة ترجع سندا.
صنف خـارجي {
  متغير داخلي: داخـلي؛
  متغير استدعاءات: صحيح؛
  @حقنة عملية هذا.خصلة: سند[داخـلي] {
    ++هذا.استدعاءات؛
    أرجع هذا.داخلي؛
  }؛
}

// عملية قراءة ترجع قيمة لها حقنتها الخاصة (سـندنا).
صنف مـشترك {
  متغير سن: سـندنا[داخـلي]؛
  @حقنة عملية هذا.خصلة: سـندنا[داخـلي] {
    أرجع هذا.سن؛
  }؛
}

// عملية قراءة معرفة كمؤشر دالة.
صنف خـارجي_مؤشر {
  متغير داخلي: داخـلي؛
  @حقنة عملية هذا.خصلة: سند[داخـلي] كمؤشر {
    أرجع هذا.داخلي؛
  }؛
}

// الأعضاء المباشرون لهم الأولوية على الأعضاء المحقونين.
صنف حـاجب {
  متغير س: صحيح؛
  متغير داخلي: داخـلي؛
  @حقنة عملية هذا.خصلة: سند[داخـلي] {
    أرجع هذا.داخلي؛
  }؛
}

// عملية قراءة ترجع الكائن نفسه يجب ألا تسبب بحثا لا نهائيا.
صنف دائـري {
  متغير ق: صحيح؛
  @حقنة عملية هذا.نفسه: سند[دائـري] {
    أرجع هذا؛
  }؛
}

صنف أسـاس {
  صنف جـدول {
    عملية (هذا: أسـاس).صف() {
      اطبع("أسـاس.صف: ق = %d\ج"، هذا.ق)؛
    }؛
  }
  @مشترك متغير جدول_مشترك: جـدول؛
  @دون_ربط @حقنة متغير جدول: سند[جـدول](جدول_مشترك)؛
  متغير ق: صحيح؛
}

// حقنة الأساس معرفة قبل حقنة الجدول، لذا يُوصل إلى الأعضاء الموجودة في كليهما عبر الأساس.
صنف فـرع {
  @حقنة متغير أساس: أسـاس؛
  صنف جـدول {
    @دون_ربط @حقنة متغير أساس: أسـاس.جـدول؛
    عملية (هذا: فـرع).خاص_بالفرع() {
      اطبع("فـرع.خاص_بالفرع: ق + ك = %d\ج"، هذا.أساس.ق + هذا.ك)؛
    }؛
  }
  @مشترك متغير جدول_مشترك: جـدول؛
  @دون_ربط @حقنة عملية هذا.جدول: سند[جـدول] {
    أرجع هذا.أساس.جدول~مؤشر~مثل[مؤشر[جـدول]]~محتوى؛
  }؛
  متغير ك: صحيح؛
  عملية هذا~هيئ() {
    هذا.أساس.جدول~عطل_التتبع = فـرع.جدول_مشترك~مؤشر~مثل[مؤشر[أسـاس.جـدول]]~محتوى؛
  }؛
}

// حقنة الجدول معرفة قبل حقنة الأساس، لذا يُوصل إلى الأعضاء الموجودة في كليهما عبر الجدول.
صنف فـرع2 {
  @دون_ربط @حقنة عملية هذا.جدول: سند[جـدول] {
    أرجع هذا.أساس.جدول~مؤشر~مثل[مؤشر[جـدول]]~محتوى؛
  }؛
  @حقنة متغير أساس: أسـاس؛
  صنف جـدول {
    @دون_ربط @حقنة متغير أساس: أسـاس.جـدول؛
    عملية (هذا: فـرع2).خاص_بالفرع() {
      اطبع("فـرع2.خاص_بالفرع: ق + ك = %d\ج"، هذا.أساس.ق + هذا.ك)؛
    }؛
  }
  @مشترك متغير جدول_مشترك: جـدول؛
  متغير ك: صحيح؛
  عملية هذا~هيئ() {
    هذا.أساس.جدول~عطل_التتبع = فـرع2.جدول_مشترك~مؤشر~مثل[مؤشر[أسـاس.جـدول]]~محتوى؛
  }؛
}

// نفس المبدلات مطبقة مباشرة على الدالات بدل العمليات.
صنف خـارجي_دالة {
  متغير داخلي: داخـلي؛
  @حقنة @عملية[""] @عضو دالة خصلة(هذا: سند[هذا_الصنف]): سند[داخـلي] {
    أرجع هذا.داخلي؛
  }؛
}

صنف حـامل_دالة {
  متغير ق: صحيح؛
  صنف جـدول {
    عملية (هذا: حـامل_دالة).اعرض() {
      اطبع("حـامل_دالة.اعرض: ق = %d\ج"، هذا.ق)؛
    }؛
  }
  @مشترك متغير جدول: جـدول؛
  @دون_ربط @حقنة @عملية[""] @عضو دالة جدولي(هذا: سند[هذا_الصنف]): سند[جـدول] {
    أرجع حـامل_دالة.جدول؛
  }؛
}

// الحقن المشتركة، سواء كانت متغيرات مشتركة أو عمليات قراءة غير عضوية، يمكن الوصول إليها دون كائن كما في المتغيرات المشتركة.
صنف إعـدادات {
  متغير نمط: صحيح؛
  عملية هذا.اعرض_النمط() {
    اطبع("إعـدادات.اعرض_النمط: نمط = %d\ج"، هذا.نمط)؛
  }؛
}

صنف تـطبيق {
  متغير رقم: صحيح؛
  @مشترك @حقنة متغير داخلي: داخـلي؛
  @مشترك متغير مخزن_الإعدادات: إعـدادات؛
  @حقنة @عملية[""] دالة إعدادات(): سند[إعـدادات] {
    أرجع تـطبيق.مخزن_الإعدادات؛
  }؛
  عملية هذا.شغل() {
    س = 14؛
    نمط = 15؛
    اطبع("تـطبيق.شغل: رقم = %d، س = %d، هات_س() = %d\ج"، هذا.رقم، س، هات_س())؛
    اعرض_النمط()؛
  }؛
}

// الحقنة المشتركة المعرفة أولا لا تعامل كعضو أول مضمّن (من قبل محولات سـندنا مثلا).
صنف مـشترك_أولا {
  @مشترك @حقنة متغير داخلي: داخـلي؛
  متغير ص: صحيح؛
}

متغير خ: خـارجي؛
خ.استدعاءات = 0؛
خ.س = 5؛
اطبع("خ.داخلي.س = %d\ج"، خ.داخلي.س)؛
اطبع("خ.هات_س() = %d\ج"، خ.هات_س())؛
اطبع("خ.استدعاءات = %d\ج"، خ.استدعاءات)؛

متغير م: مـشترك؛
م.سن.احجز()~هيئ()؛
م.س = 6؛
اطبع("م.هات_س() = %d\ج"، م.هات_س())؛

متغير ش: خـارجي_مؤشر؛
ش.س = 7؛
اطبع("ش.داخلي.س = %d\ج"، ش.داخلي.س)؛
اطبع("ش.هات_س() = %d\ج"، ش.هات_س())؛

متغير ح: حـاجب؛
ح.س = 8؛
ح.داخلي.س = 9؛
اطبع("ح.س = %d، ح.هات_س() = %d\ج"، ح.س، ح.هات_س())؛

متغير د: دائـري؛
د.ق = 10؛
اطبع("د.ق = %d\ج"، د.ق)؛

متغير ف: فـرع؛
ف.ق = 3؛
ف.ك = 4؛
ف.صف()؛
ف.خاص_بالفرع()؛

متغير ف2: فـرع2؛
ف2.ق = 5؛
ف2.ك = 6؛
ف2.صف()؛
ف2.خاص_بالفرع()؛

متغير خد: خـارجي_دالة؛
خد.س = 12؛
اطبع("خد.داخلي.س = %d، خد.هات_س() = %d\ج"، خد.داخلي.س، خد.هات_س())؛

متغير حد: حـامل_دالة؛
حد.ق = 13؛
حد.اعرض()؛

