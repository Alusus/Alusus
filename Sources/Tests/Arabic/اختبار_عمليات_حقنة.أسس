اطبع("تـطبيق.س = %d، تـطبيق.هات_س() = %d\ج"، تـطبيق.س، تـطبيق.هات_س())؛
تـطبيق.اعرض_النمط()؛

متغير مأ: سـندنا[مـشترك_أولا]؛
مأ.احجز()~هيئ()؛
مأ.ص = 18؛
اطبع("مأ.ص = %d\ج"، مأ.ص)؛

// حقن المتغيرات المحلية، بما فيها المشتركة وعمليات قراءة الخصال.
متغير داخلي_عام: داخـلي؛
دالة هات_داخلي_عام(): سند[داخـلي] { أرجع داخلي_عام }

دالة اختبر_المحلية {
  @مشترك @حقنة متغير عداد: داخـلي؛
  س += 1؛
  اطبع("اختبر_المحلية: س المشترك = %d\ج"، هات_س())؛
}

دالة اختبر_الخصلة_المحلية {
  @حقنة @عملية[""] عرف خصلة: مؤشر[دالة (): سند[داخـلي]]؛
  خصلة = هات_داخلي_عام~مؤشر؛
  س = 19؛
  اطبع("اختبر_الخصلة_المحلية: هات_س() = %d، داخلي_عام.س = %d\ج"، هات_س()، داخلي_عام.س)؛
}

اختبر_المحلية()؛
اختبر_المحلية()؛
اختبر_الخصلة_المحلية()؛
