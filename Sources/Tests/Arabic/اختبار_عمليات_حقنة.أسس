اشمل "مـتم/طـرفية.أسس"؛
اشمل "مـتم/سندات.أسس"؛

استخدم مـتم؛
استخدم مـتم.طـرفية؛

صنف داخـلي {
  متغير س: صحيح؛
  عملية هذا.هات_س(): صحيح {
    أرجع هذا.س؛
  }؛
}

// عملية قراءة ترجع سندا.
صنف خـارجي {
  متغير داخلي: داخـلي؛
  متغير استدعاءات: صحيح؛
  @حقنة عملية هذا.خصلة: سند[داخـلي] {
    ++هذا.استدعاءات؛
    أرجع هذا.داخلي؛
  }؛
}

// عملية قراءة ترجع قيمة لها حقنتها الخاصة (سـندنا).
صنف مـشترك {
  متغير سن: سـندنا[داخـلي]؛
  @حقنة عملية هذا.خصلة: سـندنا[داخـلي] {
    أرجع هذا.سن؛
  }؛
}

// عملية قراءة معرفة كمؤشر دالة.
صنف خـارجي_مؤشر {
  متغير داخلي: داخـلي؛
  @حقنة عملية هذا.خصلة: سند[داخـلي] كمؤشر {
    أرجع هذا.داخلي؛
  }؛
}

// الأعضاء المباشرون لهم الأولوية على الأعضاء المحقونين.
صنف حـاجب {
  متغير س: صحيح؛
  متغير داخلي: داخـلي؛
  @حقنة عملية هذا.خصلة: سند[داخـلي] {
    أرجع هذا.داخلي؛
  }؛
}

// عملية قراءة ترجع الكائن نفسه يجب ألا تسبب بحثا لا نهائيا.
صنف دائـري {
  متغير ق: صحيح؛
  @حقنة عملية هذا.نفسه: سند[دائـري] {
    أرجع هذا؛
  }؛
}

صنف أسـاس {
  صنف جـدول {
    عملية (هذا: أسـاس).صف() {
      اطبع("أسـاس.صف: ق = %d\ج"، هذا.ق)؛
    }؛
  }
  @مشترك متغير جدول_مشترك: جـدول؛
  @دون_ربط @حقنة متغير جدول: سند[جـدول](جدول_مشترك)؛
  متغير ق: صحيح؛
}

// حقنة الأساس معرفة قبل حقنة الجدول، لذا يُوصل إلى الأعضاء الموجودة في كليهما عبر الأساس.
صنف فـرع {
  @حقنة متغير أساس: أسـاس؛
  صنف جـدول {
    @دون_ربط @حقنة متغير أساس: أسـاس.جـدول؛
    عملية (هذا: فـرع).خاص_بالفرع() {
      اطبع("فـرع.خاص_بالفرع: ق + ك = %d\ج"، هذا.أساس.ق + هذا.ك)؛
    }؛
  }
  @مشترك متغير جدول_مشترك: جـدول؛
  @دون_ربط @حقنة عملية هذا.جدول: سند[جـدول] {
    أرجع هذا.أساس.جدول~مؤشر~مثل[مؤشر[جـدول]]~محتوى؛
  }؛
  متغير ك: صحيح؛
  عملية هذا~هيئ() {
    هذا.أساس.جدول~عطل_التتبع = فـرع.جدول_مشترك~مؤشر~مثل[مؤشر[أسـاس.جـدول]]~محتوى؛
  }؛
}

// حقنة الجدول معرفة قبل حقنة الأساس، لذا يُوصل إلى الأعضاء الموجودة في كليهما عبر الجدول.
صنف فـرع2 {
  @دون_ربط @حقنة عملية هذا.جدول: سند[جـدول] {
    أرجع هذا.أساس.جدول~مؤشر~مثل[مؤشر[جـدول]]~محتوى؛
  }؛
  @حقنة متغير أساس: أسـاس؛
  صنف جـدول {
    @دون_ربط @حقنة متغير أساس: أسـاس.جـدول؛
    عملية (هذا: فـرع2).خاص_بالفرع() {
      اطبع("فـرع2.خاص_بالفرع: ق + ك = %d\ج"، هذا.أساس.ق + هذا.ك)؛
    }؛
  }
  @مشترك متغير جدول_مشترك: جـدول؛
  متغير ك: صحيح؛
  عملية هذا~هيئ() {
    هذا.أساس.جدول~عطل_التتبع = فـرع2.جدول_مشترك~مؤشر~مثل[مؤشر[أسـاس.جـدول]]~محتوى؛
  }؛
}

