اشمل "مـتم/طـرفية"؛
اشمل "مـتم/نـص"؛
اشمل "مـتم/مـنشئ_نص"؛
استخدم مـتم؛

// مكون لتوسيع دالة املأ برمز جديد.
عرف مـكون_المنشئ: {
    @منسق_نص["gd"]
    عملية هذا.املأ_ختما(خز: صـحيح[64]) {
        هذا.ألحق("<تاريخ:")؛
        هذا.ألحق(خز)؛
        هذا.ألحق(">")؛
    }
}

دالة رئيسي {
    عرف من: مـنشئ_نص[مـكون_المنشئ](1024، 512)؛
    من.املأ("اليوم %gd، العدد=%i، الاسم=%s"، 1234~مثل[صـحيح[64]]، 7، "اختبار")؛
    طـرفية.اطبع("%s\ج"، من~مثل[سند[نـص]].صوان)؛
}

رئيسي()؛
