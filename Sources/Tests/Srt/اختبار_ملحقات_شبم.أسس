اشمل "مـتم/طـرفية"؛
اشمل "مـتم/سندات"؛
اشمل "مـتم/نـص"؛
اشمل "المترجم"؛

استخدم مـتم؛
استخدم الـقلب.أسـاسيات؛
استخدم الـقلب.شـبم؛

// --- دوال الوصول للأعضاء التي تُخزّن بالقيمة ---------------------------------------
// الأعضاء التي تُخزّن بالقيمة (نصوص، أرقام، ...) تُعاد كسند للعضو نفسه.
متغير رابط: سـندنا[مـؤثر_ربط] = أنشئ_كائنا_مشتركا[مـؤثر_ربط]؛
رابط.النوع = نـص_بهوية(":")؛
طـرفية.اطبع("link.type: %s\ج"، رابط.النوع.القيمة.صوان)؛

// --- دوال الوصول للعقد النصية ---------------------------------------------------------
متغير معرف: سـندنا[مـعرف] = مـعرف.أنشئ("abc")؛
طـرفية.اطبع("id.value: %s\ج"، معرف.القيمة.القيمة.صوان)؛
معرف.القيمة.القيمة = "xyz"؛
طـرفية.اطبع("id.value: %s\ج"، معرف.القيمة.القيمة.صوان)؛

// --- دوال الوصول للأعضاء المرجعية ------------------------------------------------------
// تقرر العقدة بنفسها إن كانت ستتملك الكائن الممرر أم ستكتفي بالإشارة إليه. العقدة مـمر لا تتملك هدفها، أما
// العقد الأخرى فتتملك قائمة المعدِّلات الخاصة بها.
متغير ممر: سـندنا[مـمر] = أنشئ_كائنا_مشتركا[مـمر]؛
طـرفية.اطبع("passage.target is null: %i\ج"، (ممر.الهدف~مؤشر == 0)~مثل[صحيح])؛
متغير هدف: سـندنا[مـعرف] = مـعرف.أنشئ("target")؛
ممر.الهدف = مثل_سندا[هدف.كائن، عـقدة]؛
طـرفية.اطبع("passage.target: %s\ج"، مثل_سندا[ممر.الهدف، مـعرف].القيمة.القيمة.صوان)؛
طـرفية.اطبع("passage owns target: %i\ج"، (ممر.الهدف.المالك~مؤشر == ممر.كائن~مؤشر)~مثل[صحيح])؛

دالة حدد_المبدلات (ع: سند[مـعرف]) {
    متغير معدلات: سـندنا[قـائمة] = أنشئ_كائنا_مشتركا[قـائمة]؛
    ع.المبدلات = معدلات.كائن؛
}
حدد_المبدلات(معرف.كائن)؛
طـرفية.اطبع("id.modifiers is set: %i\ج"، (معرف.المبدلات~مؤشر != 0)~مثل[صحيح])؛
طـرفية.اطبع("id owns its modifiers: %i\ج"، (معرف.المبدلات.المالك~مؤشر == معرف.كائن~مؤشر)~مثل[صحيح])؛

// --- دوال الوصول متوافقة مع وسيط الربط -------------------------------------------------
متغير تعريف: سـندنا[تـعريف] = أنشئ_كائنا_مشتركا[تـعريف]؛
تعريف.الاسم = نـص_بهوية("myDef")؛
طـرفية.اطبع("definition.name through binding: %s\ج"، مثل_سندا[رابـط[تعريف.كائن].هات_عضوا("name")، نـص_بهوية].القيمة.صوان)؛
رابـط[تعريف.كائن].حدد_عضوا("name"، نـص_بهوية("otherDef"))؛
طـرفية.اطبع("definition.name: %s\ج"، تعريف.الاسم.القيمة.صوان)؛

// --- الأعضاء من نوع تعداد -------------------------------------------------------------------
// التعدادات أصناف قائمة بذاتها (مشتقة من صـحيح_بهوية) وقيمها متاحة كأعضاء ساكنة.
متغير قوس: سـندنا[قـوس] = أنشئ_كائنا_مشتركا[قـوس]؛
طـرفية.اطبع("bracket.type: %i\ج"، قوس.النوع.القيمة)؛
قوس.النوع = نـوع_قوس.SQUARE؛
طـرفية.اطبع("bracket.type: %i\ج"، قوس.النوع.القيمة)؛

// --- دوال الوصول لعقد نـبم ---------------------------------------------------------------------
متغير دالة_نبم: سـندنا[نـبم.شـبم.دالـة] = أنشئ_كائنا_مشتركا[نـبم.شـبم.دالـة]؛
دالة_نبم.الاسم = نـص_بهوية("myFunc")؛
دالة_نبم.مضمن = ثـنائي_بهوية(1)؛
طـرفية.اطبع("func.name: %s\ج"، دالة_نبم.الاسم.القيمة.صوان)؛
طـرفية.اطبع("func.inlined: %i\ج"، دالة_نبم.مضمن.القيمة~مثل[صحيح])؛
متغير نوع_سند: سـندنا[نـبم.شـبم.صـنف_سند] = أنشئ_كائنا_مشتركا[نـبم.شـبم.صـنف_سند]؛
نوع_سند.النمط = نـبم.شـبم.نـمط_سند._ضمني_؛
طـرفية.اطبع("refType.mode: %i\ج"، نوع_سند.النمط.القيمة)؛

// --- دوال الوصول لعناصر المعجم ----------------------------------------------------------------
// يتم الوصول لعناصر المعجم بنفس طريقة الوصول للأعضاء الأخرى.
متغير أول: سـندنا[مـعرف] = مـعرف.أنشئ("a")؛
متغير ثاني: سـندنا[مـعرف] = مـعرف.أنشئ("b")؛
طـرفية.اطبع("link.first is null: %i\ج"، (رابط.الأول~مؤشر == 0)~مثل[صحيح])؛
رابط.الأول = مثل_سندا[أول.كائن، عـقدة]؛
رابط.الثاني = مثل_سندا[ثاني.كائن، عـقدة]؛
طـرفية.اطبع("link: %s.%s\ج"، مثل_سندا[رابط.الأول، مـعرف].القيمة.القيمة.صوان، مثل_سندا[رابط.الثاني، مـعرف].القيمة.القيمة.صوان)؛
طـرفية.اطبع("link owns first: %i\ج"، (رابط.الأول.المالك~مؤشر == رابط.كائن~مؤشر)~مثل[صحيح])؛
تعريف.الموضوع = مثل_سندا[ثاني.كائن، عـقدة]؛
طـرفية.اطبع("definition.subject: %s\ج"، مثل_سندا[تعريف.الموضوع، مـعرف].القيمة.القيمة.صوان)؛
متغير نوع_دالة: سـندنا[نـبم.شـبم.صـنف_دالة] = أنشئ_كائنا_مشتركا[نـبم.شـبم.صـنف_دالة]؛
متغير معطيات: سـندنا[مـعجم] = أنشئ_كائنا_مشتركا[مـعجم]؛
دالة_نبم.الصنف = نوع_دالة.كائن؛
نوع_دالة.أصناف_المعطيات = معطيات.كائن؛
طـرفية.اطبع("func.type.argTypes is set: %i\ج"، (دالة_نبم.الصنف.أصناف_المعطيات~مؤشر != 0)~مثل[صحيح])؛

// --- عبارة إذا ------------------------------------------------------------------
متغير عبارة_إذا: سـندنا[نـبم.شـبم.عـبارة_إذا] = أنشئ_كائنا_مشتركا[نـبم.شـبم.عـبارة_إذا]؛
عبارة_إذا.متن_وإلا = نـص_حرفي.أنشئ("متن وإلا")؛
طـرفية.اطبع("else block: %s\ج"، مثل_سندا[عبارة_إذا.متن_وإلا، نـص_حرفي].القيمة.القيمة.صوان)؛
