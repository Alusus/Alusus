import "Spp";
import "Srl/refs_base";

preprocess {
    use Srl;
    def TioSrdRef: alias SrdRef[Core.Ast.Node];
    Spp.grammarMgr.addCustomCommand(
        "TestCommand",
        (ast {
            keywords: "testcommand";
            args: "module".Expression*(1,1);
        }),
        func (data: TioSrdRef): TioSrdRef {
            def container: Core.Basic.ContainerOf[data.obj, Core.Ast.Node];
            return Spp.astMgr.buildAst(
                (ast testCommand[arg]),
                Map[String, ref[Core.Ast.Node]]().set(String("arg"), container.getElement(1))
            );
        }
    );
}

def a: {
    testcommand a + b;
}
dump_ast a;
