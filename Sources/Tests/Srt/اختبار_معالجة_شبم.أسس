اشمل "مـتم/طـرفية"؛
اشمل "مـتم/سندات"؛
اشمل "مـتم/نـظام"؛
اشمل "مـتم/نـص"؛
اشمل "مـتم/مـعجم"؛
اشمل "المترجم"؛

استخدم مـتم؛
استخدم الـقلب.أسـاسيات؛
استخدم الـقلب.شـبم؛
عرف سـندنا_لعقدة: لقب سـندنا[الـقلب.شـبم.عـقدة]؛

دالة أنشئ_حيثما (كائن: سند[عـقدة]): سـندنا_لعقدة {
    عرف نتيجة: سـندنا_لعقدة؛
    إذا كائن~مؤشر == 0 {
        نـظام.فشل(1، "أنشئ_حيثما: الكائن معدوم.\ج")؛
    }

    إذا أمشتق_من[كائن، مـؤثر_مقارنة] {
        عرف ربط: سند[ربـط](هات_وسيطا[كائن، ربـط])؛
        عرف حاوية_معجم: سند[احـتواء_معجمي[عـقدة]](هات_وسيطا[كائن، احـتواء_معجمي[عـقدة]])؛
        إذا !نـبم.مدير_شبم.أنشئ_شبم(
            شبم { نـص("{{اسم}}") + نـص(" {{مؤثر}} '") + القيمة + نـص("'") }،
            مـعجم[نـص، سند[عـقدة]]()
                .حدد(نـص("اسم")، حاوية_معجم.هات_عنصرا("first"))
                .حدد(نـص("مؤثر")، نـص_حرفي(مثل_سندا[ربط.هات_عضوا("type")، نـص_بهوية].القيمة.صوان))
                .حدد(نـص("القيمة")، حاوية_معجم.هات_عنصرا("second"))،
            نتيجة
        ) {
            نـظام.فشل(1، "أنشئ_حيثما/مـؤثر_مقارنة: خطأ\ج")؛
        }
    } وإلا إذا أمشتق_من[كائن، مـؤثر_منطقي] {
        عرف ربط: سند[ربـط](هات_وسيطا[كائن، ربـط])؛
        عرف حاوية_معجم: سند[احـتواء_معجمي[عـقدة]](هات_وسيطا[كائن، احـتواء_معجمي[عـقدة]])؛
        عرف مؤثر: نـص؛
        إذا مثل_سندا[ربط.هات_عضوا("type")، نـص_بهوية].القيمة == "and" مؤثر = "و" وإلا مؤثر = "أو"؛
        إذا !نـبم.مدير_شبم.أنشئ_شبم(
            شبم { (شرط1) + نـص(" {{مؤثر}} ") + (شرط2) }،
            مـعجم[نـص، سند[عـقدة]]()
                .حدد(نـص("شرط1")، أنشئ_حيثما(حاوية_معجم.هات_عنصرا("first")).كائن)
                .حدد(نـص("مؤثر")، نـص_حرفي(مؤثر.صوان))
                .حدد(نـص("شرط2")، أنشئ_حيثما(حاوية_معجم.هات_عنصرا("second")).كائن)،
            نتيجة
        ) {
            نـظام.فشل(1، "أنشئ_حيثما/مـؤثر_منطقي: خطأ\ج")؛
        }
    } وإلا إذا أمشتق_من[كائن، قـوس] {
        عرف حاوية_معجم: سند[احـتواء_معجمي[عـقدة]](هات_وسيطا[كائن، احـتواء_معجمي[عـقدة]])؛
        إذا !نـبم.مدير_شبم.أنشئ_شبم(
            شبم { نـص("(") + (شرط) + نـص(")") }،
            مـعجم[نـص، سند[عـقدة]]()
                .حدد(نـص("شرط")، أنشئ_حيثما(حاوية_معجم.هات_عنصرا("operand")).كائن)،
            نتيجة
        ) {
            نـظام.فشل(1، "أنشئ_حيثما/قـوس: خطأ\ج")؛
        }
    } وإلا {
        إذا !نـبم.مدير_شبم.أنشئ_شبم(
            كائن،
            مـعجم[نـص، سند[عـقدة]]()،
            نتيجة
        ) {
            نـظام.فشل(1، "فشل بناء الشرط.\ج")؛
        }
    }
    أرجع نتيجة؛
}

ماكرو حيثما [شرط] {
    تمهيد {
        إذا !نـبم.مدير_شبم.احشر_شبم(
            أنشئ_حيثما(شبم شرط).كائن
        ) {
            نـظام.فشل(1، "فشل حشر الشرط.\ج")؛
        }
    }
}

دالة اختبر {
    عرف الاسم_الأول: نـص("محمد")؛
    عرف الوظيفة: نـص("مهندس")؛
    متغير حيثما: نـص = حيثما[الاسم == الاسم_الأول و (الوظيفة == الوظيفة أو الوظيفة == "محامي")]؛
    طـرفية.اطبع("%s\ج"، حيثما.صوان)؛
}
اختبر()؛

