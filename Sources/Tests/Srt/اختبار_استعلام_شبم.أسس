اشمل "مـتم/تـطبيق"؛
اشمل "مـتم/نـص"؛
اشمل "الـقلب/شـبم"؛
اشمل "نـبم"؛
استخدم مـتم؛

دالة أنشئ_إضافة_أسماء_العناصر (اسم_المتغير: نـص، العناصر: مـصفوفة[سند[الـقلب.شـبم.عـقدة]]) {
    عرف ع: صحيح؛
    لكل ع = 0، ع < العناصر.هات_الطول()، ++ع {
        عرف عقدة: سند[الـقلب.شـبم.عـقدة](مثل_سندا[العناصر(ع)، الـقلب.شـبم.عـقدة])؛
        عرف ت: سند[الـقلب.شـبم.تـعريف](مثل_سندا[عقدة.المالك، الـقلب.شـبم.تـعريف])؛
        عرف ربط: سند[الـقلب.أسـاسيات.ربـط](الـقلب.أسـاسيات.هات_وسيطا[ت، الـقلب.أسـاسيات.ربـط])؛
        نـبم.مدير_شبم.احشر_شبم(
            شبم { أسماء.أضف(نـص("{{اسم}}")) }،
            تـطبيق[نـص، سند[الـقلب.شـبم.عـقدة]]()
                .حدد(نـص("أسماء")، الـقلب.شـبم.مـعرف(اسم_المتغير))
                .حدد(نـص("اسم")، الـقلب.شـبم.نـص_حرفي(
                    مثل_سندا[ربط.هات_عضوا("name")، الـقلب.أسـاسيات.نـص_بهوية].القيمة.صوان
                ))
        )؛
    }
}

ماكرو أنجز_هات_أسماء_العناصر [الشرط، المالك] {
    عرف أسماء: مـصفوفة[نـص]؛
    تمهيد {
        عرف العناصر: مـصفوفة[سند[الـقلب.شـبم.عـقدة]]؛
        العناصر = نـبم.مدير_شبم.جد_عناصر(
            شبم { الشرط }،
            المالك،
            نـبم.خـيارات_الساعي._تخطى_المالكين_ | نـبم.خـيارات_الساعي._تخطى_الاستخدامات_ | نـبم.خـيارات_الساعي._تخطى_الأبناء_
        )؛
        أنشئ_إضافة_أسماء_العناصر(نـص("أسماء")، العناصر)؛
    }
    أرجع أسماء
}

دالة اطبع_مبدلات (عنصر: سند[الـقلب.شـبم.عـقدة]) {
    عرف مبدلات: سند[الـقلب.أسـاسيات.احـتواء[الـقلب.شـبم.عـقدة]](نـبم.مدير_شبم.هات_المبدلات(عنصر))؛
    إذا مبدلات~مؤشر == 0 {
        طـرفية.اطبع("عدم\ج")؛
    } وإلا {
        عرف ع: صحيح؛
        لكل ع = 0، ع < مبدلات.هات_عدد_العناصر()~مثل[صحيح]، ++ع {
            طـرفية.اطبع("%s\ج"، نـبم.مدير_شبم.هات_كلمة_المبدل_المفتاحية(مبدلات.هات_عنصرا(ع)).صوان)؛
        }
    }
}

دالة اطبع_معطيات_مبدل (مبدل: سند[الـقلب.شـبم.عـقدة]) {
    عرف معطيات: مـصفوفة[نـص]؛
    نـبم.مدير_شبم.هات_المعطيات_النصية_لمبدل(مبدل، معطيات)؛
    عرف ع: صحيح؛
    لكل ع = 0، ع < معطيات.هات_الطول()، ++ع {
        طـرفية.اطبع("%s\ج"، معطيات(ع).صوان)؛
    }
}

دالة اطبع_بيانات_وصفية_عنصر (عنصر: سند[الـقلب.شـبم.عـقدة]، الاسم: مؤشر[مصفوفة[محرف]]) {
    // البيانات الوصفية تُحدد على التعريف المالك للعنصر الموسوم بالمبدل، وليس على العنصر نفسه.
    عرف عقدة_المعطيات: سند[الـقلب.شـبم.عـقدة](عنصر.المالك.هات_بيانات_وصفية(الاسم))؛
    إذا عقدة_المعطيات~مؤشر == 0 {
        طـرفية.اطبع("عدم\ج")؛
    } وإلا {
        // المعالجات أدناه تخزن معطيات المبدل الخام (وليس مرجع المبدل نفسه)، لذا تُقرأ مباشرة بدلا من
        // المرور عبر هات_المعطيات_النصية_لمبدل التي تتوقع تمرير معطى.
        عرف قائمة: الـقلب.أسـاسيات.حـاوية[عقدة_المعطيات، الـقلب.شـبم.عـقدة]؛
        إذا قائمة~مؤشر != 0 {
            عرف ع: صحيح؛
            لكل ع = 0، ع < قائمة.هات_عدد_العناصر()~مثل[صحيح]، ++ع {
                عرف عنصر_نصي: سند[الـقلب.شـبم.نـص_حرفي](مثل_سندا[قائمة.هات_عنصرا(ع)، الـقلب.شـبم.نـص_حرفي])؛
                طـرفية.اطبع("%s\ج"، عنصر_نصي.القيمة.القيمة.صوان)؛
            }
        } وإلا {
            عرف عنصر_نصي: سند[الـقلب.شـبم.نـص_حرفي](مثل_سندا[عقدة_المعطيات، الـقلب.شـبم.نـص_حرفي])؛
            طـرفية.اطبع("%s\ج"، عنصر_نصي.القيمة.القيمة.صوان)؛
        }
    }
}

ماكرو عرف_ماكرو [اسم_الماكرو] {
    دالة اسم_الماكرو (عقدة: سند[الـقلب.شـبم.عـقدة]، معطيات: سند[الـقلب.شـبم.عـقدة]) {
        عقدة.حدد_بيانات_وصفية("{{اسم_الماكرو}}"، نـبم.مدير_شبم.كرر_شبم(معطيات، معطيات))؛
    }
}

عرف_ماكرو[مبدل_ا]؛
عرف_ماكرو[مبدل_ب]؛
عرف_ماكرو[مبدل_ت]؛

دالة خاص (عقدة: سند[الـقلب.شـبم.عـقدة]، معطيات: سند[الـقلب.شـبم.عـقدة]) {
    // معالجات المبدلات تُنفذ ضمن جلسة بناء التمهيد، والتي تبقى على قيد الحياة طوال عمر البرنامج، إلا أن
    // مدير البناء الذي يحمل جلسة التمهيد يُتلف قبل شجرة البنية المجردة عند إنهاء البرنامج. لذا فإن إنشاء
    // كائن مباشرة هنا (مثلا عبر .أنشئ() لمصنع) ثم إلحاقه بشجرة البنية المجردة يجعل جزءا من الشجرة معتمدا
    // على شفرة جلسة التمهيد عند التدمير، ذلك أن دالة إنهاء السند المشترك لهذا الكائن تُولَّد ضمن جلسة
    // التمهيد لا في جانب المترجم نفسه. لذا، ولتفادي خطأ تجزئة في نهاية البرنامج، ينبغي دائما استخدام شفرة
    // مولَّدة في جانب المترجم باستخدام دالة كرر_شبم.
    عقدة.حدد_بيانات_وصفية("خاص"، نـبم.مدير_شبم.كرر_شبم(شبم { 1 }، عقدة))؛
}

صنف صـنف {
    @مبدل_ا @مبدل_ب["ا-ب-ت"، "ج-ح-خ"] @مبدل_ت["د-ذ-ر"، "ز-س-ش"]
    عرف س: صحيح؛

    @خاص عرف ص: صحيح؛

    @عضو دالة هات_أسماء_المتغيرات (هذا: سند[هذا_الصنف]): مـصفوفة[نـص] {
        أنجز_هات_أسماء_العناصر[نوع_العنصر == "متغير"، هذا_الصنف~شبم]؛
    }

    @خاص @عضو  دالة هات_أسماء_الدالات (هذا: سند[هذا_الصنف]): مـصفوفة[نـص] {
        أنجز_هات_أسماء_العناصر[نوع_العنصر == "دالة"، هذا_الصنف~شبم]؛
    }

    @عضو دالة هات_أسماء_العناصر_الخاصة (هذا: سند[هذا_الصنف]): مـصفوفة[نـص] {
        أنجز_هات_أسماء_العناصر[بيانات_وصفية == "خاص"، هذا_الصنف~شبم]؛
    }
}

دالة هات_أسماء_الأصناف (): مـصفوفة[نـص] {
    أنجز_هات_أسماء_العناصر[نوع_العنصر == "صنف"، الـجذر~شبم]؛
}

دالة هات_أسماء_الوحدات (): مـصفوفة[نـص] {
    أنجز_هات_أسماء_العناصر[نوع_العنصر == "وحدة"، الـجذر~شبم]؛
}

دالة اطبع_أسماء (أسماء: مـصفوفة[نـص]) {
    عرف ع: صحيح؛
    لكل ع = 0، ع < أسماء.هات_الطول()، ++ع {
        طـرفية.اطبع("%s\ج"، أسماء(ع).صوان)؛
    }
}

عرف ص: صـنف؛
طـرفية.اطبع("أسماء المتغيرات:\ج")؛
اطبع_أسماء(ص.هات_أسماء_المتغيرات())؛

طـرفية.اطبع("\جأسماء الدالات:\ج")؛
اطبع_أسماء(ص.هات_أسماء_الدالات())؛

طـرفية.اطبع("\جأسماء العناصر الخاصة:\ج")؛
اطبع_أسماء(ص.هات_أسماء_العناصر_الخاصة())؛

طـرفية.اطبع("\جأسماء الأصناف:\ج")؛
اطبع_أسماء(هات_أسماء_الأصناف())؛

طـرفية.اطبع("\جأسماء الوحدات:\ج")؛
اطبع_أسماء(هات_أسماء_الوحدات())؛

طـرفية.اطبع("\جمبدلات صـنف.س:\ج")؛
اطبع_مبدلات(صـنف.س~شبم)؛

طـرفية.اطبع("\جمعطيات @مبدل_ب الملتقطة للعنصر صـنف.س:\ج")؛
اطبع_بيانات_وصفية_عنصر(صـنف.س~شبم، "مبدل_ب")؛

طـرفية.اطبع("\جمعطيات @مبدل_ت الملتقطة للعنصر صـنف.س:\ج")؛
اطبع_بيانات_وصفية_عنصر(صـنف.س~شبم، "مبدل_ت")؛
