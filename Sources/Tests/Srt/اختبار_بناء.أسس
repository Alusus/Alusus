اشمل "مـتم/طـرفية.أسس"؛
اشمل "مـتم/نـظام.أسس"؛
اشمل "مـتم/ذاكـرة.أسس"؛
اشمل "مـتم/مـصفوفة.أسس"؛
اشمل "مـتم/نـص.أسس"؛
اشمل "بـناء.أسس"؛

@تصدير[main] دالة ابدأ {
  مـتم.طـرفية.اطبع("تحية من ملف تنفيذي.\ج")؛
}؛

@تصدير[main] دالة ابدأ2 {
  مـتم.طـرفية.اطبع("تحية من ملف تنفيذي آخر.\ج")؛
}؛

إذا !بـناء.أنشئ_تنفيذيا(ابدأ~شبم، "/tmp/اختبار_الأسس") {
  مـتم.طـرفية.اطبع("فشل البناء.\ج")؛
} وإلا {
  مـتم.نـظام.شغل("/tmp/اختبار_الأسس")؛
}؛

عرف تنفيذي: بـناء.تـنفيذي(ابدأ2~شبم، "/tmp/اختبار_الأسس2")؛
إذا !تنفيذي.أنتج() {
  مـتم.طـرفية.اطبع("فشل البناء.\ج")؛
} وإلا {
  مـتم.نـظام.شغل("/tmp/اختبار_الأسس2")؛
}؛


@بـناء.اعتماديات["libm.so.6"، "libc.so.6"]
@تصدير[main] دالة ابدأ3 {
}؛

عرف وحدة_ب: بـناء.وحدة_بناء(ابدأ3~شبم، "/tmp/اختبار_الأسس3")؛
عرف ع: صحيح؛
لكل ع = 0، ع < وحدة_ب.الاعتماديات.هات_الطول()، ++ع {
  مـتم.طـرفية.اطبع("اعتمادية: %s\ج"، وحدة_ب.الاعتماديات(ع).صوان)؛
}؛
