اشمل "مـتم/طـرفية"؛
اشمل "نـبك"؛

استخدم مـتم.طـرفية؛

// الوراثة الفردية والمتعددة المستويات

صنف شـكل {
    نـبك.عرف_جدول_دالات[جدول، جـدول]؛

    عرف ق: صحيح؛

    ضمن جـدول عملية هذا.هات(): صحيح كمؤشر {
        أرجع هذا.ق؛
    }
}

صنف مـربع {
    نـبك.اشتق_صنفا[شكل، شـكل، جدول، جـدول]؛

    عرف ك: صحيح؛

    ضمن جـدول عملية هذا.شكل.هات(): صحيح حدد_مؤشر {
        أرجع هذا.ك + هذا.شكل._هات()؛
    }

    ضمن جـدول عملية هذا.ضاعف(): صحيح كمؤشر {
        أرجع هذا.ك * 2؛
    }
}

صنف مـربع_ملون {
    نـبك.اشتق_صنفا[مربع، مـربع، مربع.جدول، مـربع.جـدول، جدول_مشترك، جـدول_المربع_الملون]؛

    ضمن جـدول_المربع_الملون عملية هذا.مربع.ضاعف(): صحيح حدد_مؤشر {
        أرجع هذا.مربع._ضاعف() * 10؛
    }
}

دالة اعرض_شكل(ش: سند[شـكل]) {
    اطبع("شكل: %d\ج"، ش.هات())؛
}

دالة اعرض_مربع(م: سند[مـربع]) {
    اطبع("مربع: %d\ج"، م.ضاعف())؛
}

دالة اختبر_الوراثة {
    اطبع("اختبر_الوراثة:\ج")؛
    عرف ش: شـكل؛
    ش.ق = 1؛
    عرف م: مـربع؛
    م.ق = 2؛
    م.ك = 3؛
    عرف مل: مـربع_ملون؛
    مل.ق = 4؛
    مل.ك = 5؛
    اعرض_شكل(ش)؛
    اعرض_شكل(م)؛
    اعرض_شكل(مل)؛
    اعرض_مربع(م)؛
    اعرض_مربع(مل)؛
}
اختبر_الوراثة()؛

// الوراثة المتعددة

صنف أسـاس1 {
    نـبك.عرف_جدول_دالات[جدول، جـدول]؛
    عرف أ: صحيح؛
    ضمن جـدول عملية هذا.هات1(): صحيح كمؤشر {
        أرجع هذا.أ؛
    }
}

صنف أسـاس2 {
    نـبك.عرف_جدول_دالات[جدول، جـدول]؛
    عرف ب: صحيح؛
    ضمن جـدول عملية هذا.هات2(): صحيح كمؤشر {
        أرجع هذا.ب؛
    }
}

صنف مـتعدد {
    نـبك.اشتق_صنفا[أساس1، أسـاس1]؛
    نـبك.اشتق_صنفا[أساس2، أسـاس2]؛
    نـبك.اشتق_جدول_دالات[أساس1، أسـاس1، أساس1.جدول، أسـاس1.جـدول، جدول_مشترك1، جـدول1]؛
    نـبك.اشتق_جدول_دالات[أساس2، أسـاس2، أساس2.جدول، أسـاس2.جـدول، جدول_مشترك2، جـدول2]؛

    ضمن جـدول1 عملية هذا.أساس1.هات1(): صحيح حدد_مؤشر {
        أرجع هذا.أ * 10؛
    }

    ضمن جـدول2 عملية هذا.أساس2.هات2(): صحيح حدد_مؤشر {
        حاذ_هذا[أساس2، مـتعدد]؛
        أرجع هذا.أ + هذا.ب * 10؛
    }
}

دالة اعرض_أساس1(أ: سند[أسـاس1]) {
    اطبع("أساس1: %d\ج"، أ.هات1())؛
}

دالة اعرض_أساس2(ب: سند[أسـاس2]) {
    اطبع("أساس2: %d\ج"، ب.هات2())؛
}

دالة اختبر_الوراثة_المتعددة {
    اطبع("اختبر_الوراثة_المتعددة:\ج")؛
    عرف م: مـتعدد؛
    م.أ = 1؛
    م.ب = 2؛
    اعرض_أساس1(م)؛
    اعرض_أساس2(م.أساس2)؛
}
اختبر_الوراثة_المتعددة()؛
