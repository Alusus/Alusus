اشمل "مـتم/طـرفية"؛
اشمل "نـبم"؛

استخدم مـتم.طـرفية؛

// أنواع تُولَّد لها عمليات النسخ بواسطة احشر_عمليات_النسخ.

صنف داخلي {
    عرف أ: صحيح؛
    عرف ب: صحيح؛
    عملية هذا~هيئ() {}
    نـبم.مدير_شبم.احشر_عمليات_النسخ[]؛
}

صنف خارجي {
    عرف س: صحيح؛
    عرف د: داخلي؛
    عملية هذا~هيئ() {}
    نـبم.مدير_شبم.احشر_عمليات_النسخ[]؛
}

دالة اختبر_الإسناد {
    عرف مصدر: خارجي؛
    مصدر.س = 1؛
    مصدر.د.أ = 2؛
    مصدر.د.ب = 3؛
    عرف هدف: خارجي؛
    هدف = مصدر؛
    اطبع("إسناد: %d، %d، %d\ج"، هدف.س، هدف.د.أ، هدف.د.ب)؛
}
اختبر_الإسناد()؛

دالة اختبر_منشئ_النسخ {
    عرف مصدر: خارجي؛
    مصدر.س = 4؛
    مصدر.د.أ = 5؛
    مصدر.د.ب = 6؛
    عرف هدف: خارجي(مصدر)؛
    اطبع("تهيئة: %d، %d، %d\ج"، هدف.س، هدف.د.أ، هدف.د.ب)؛
}
اختبر_منشئ_النسخ()؛
