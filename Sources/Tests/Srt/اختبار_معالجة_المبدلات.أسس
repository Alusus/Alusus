دالة اطبع_وسم_عنصر(عنصر: سند[الـقلب.شـبم.عـقدة]، الاسم: مؤشر[مصفوفة[محرف]]) {
    عرف القيمة: سند[الـقلب.شـبم.عـقدة](عنصر.المالك.هات_بيانات_وصفية(الاسم))؛
    إذا القيمة~مؤشر == 0 {
        طـرفية.اطبع("عدم\ج")؛
    } وإلا {
        عرف نص_حرفي: سند[الـقلب.شـبم.نـص_حرفي](مثل_سند[القيمة، الـقلب.شـبم.نـص_حرفي])؛
        طـرفية.اطبع("%s\ج"، نص_حرفي.القيمة.القيمة.صوان)؛
    }
}

