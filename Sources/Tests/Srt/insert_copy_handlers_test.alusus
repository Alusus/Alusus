import "Srl/Console";
import "Spp";

use Srl.Console;

// Types with copy handlers generated by insertCopyHandlers.

class Inner {
    def a: Int;
    def b: Int;
    handler this~init() {}
    Spp.astMgr.insertCopyHandlers[];
}

class Outer {
    def x: Int;
    def inner: Inner;
    handler this~init() {}
    Spp.astMgr.insertCopyHandlers[];
}

func testAssignment {
    def src: Outer;
    src.x = 1;
    src.inner.a = 2;
    src.inner.b = 3;
    def dst: Outer;
    dst = src;
    print("assign: %d, %d, %d\n", dst.x, dst.inner.a, dst.inner.b);
}
testAssignment();

func testCopyConstructor {
    def src: Outer;
    src.x = 4;
    src.inner.a = 5;
    src.inner.b = 6;
    def dst: Outer(src);
    print("init: %d, %d, %d\n", dst.x, dst.inner.a, dst.inner.b);
}
testCopyConstructor();
