import "Srl/Console";
use Srl;

macro duplicate [n] {
    def __n__2: n~type;
}

macro castAssign [v1, v2] {
    v2 = v1~cast[v2~type];
}

class Inner {
    def i: Int[8];
};

class Outer {
    def inner: Inner;
    def j: inner.i~type;
};

class Methods {
    def i: Int;
    handler this.ptrMethod(): Int as_ptr { return this.i + 1 }
    handler this.method(): Int { return this.i + 2 }
};

func test {
    def i: Int;
    duplicate[i];

    i = 257;
    i2 = 258;
    Console.print("%d, %d\n", i, i2);

    def pc: ptr[Int[8]];
    castAssign[i~ptr, pc];
    Console.print("%d\n", pc~cnt~cast[Int]);

    def o: Outer;
    def oi: o.inner~type;
    o.j = 257;
    oi.i = 258;
    Console.print("%d, %d\n", o.j~cast[Int], oi.i~cast[Int]);

    // Through the type, the type of an `as_ptr` method is the type of its pointer.
    def m: Methods;
    m.i = 40;
    def p: Methods.ptrMethod~type;
    p = Methods._ptrMethod~ptr;
    Console.print("%d\n", p(m));
    p = m.ptrMethod~pick[Methods.ptrMethod~type];
    Console.print("%d\n", p(m));
}
test();

// Error cases

// Through an object, the method's operation is applied, which needs a call.
if 1 {
    def m: Methods;
    def v: m.ptrMethod~type;
};

// Variables can't be of function types or Void.
def globalFn: Methods.method~type;
globalFn;

if 1 {
    def localFn: Methods.method~type;
};

if 1 {
    def v: Void;
};

class FnMember {
    def f: Methods.method~type;
};

if 1 {
    def fm: FnMember;
};

// Same for array elements and function args, while return types can be Void but not function types.
if 1 {
    def fnArray: array[Methods.method~type, 2];
};

if 1 {
    def voidArray: array[Void, 2];
};

func fnArg (f: Methods.method~type) {}
fnArg~ptr;

func voidArg (v: Void) {}
voidArg~ptr;

@expname[puts] func fnRet (): Methods.method~type;
fnRet~ptr;
