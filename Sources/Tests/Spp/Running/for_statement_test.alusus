import "alusus_spp";

def Main: module
{
  def print: @expname[printf] function (fmt: ptr[Word[8]], args: ...any)=>Int[64];

  def start: function () => Void
  {
    def i: Int[32];
    def j: Int[32];

    for i = 0, i < 10, ++i print("%d\n", i);

    for (i = 0, j = 1), i < 5, (++i, j *= 2) {
      print("%d: ", i);
      print("%d\n", j);
    };

    for k: Int = 0, k < 3, ++k print("k = %d\n", k);

    for (m: Int = 0, n: Int[64] = 10), m < 3, (++m, n += 5) {
      print("%d: ", m);
      print("%d\n", n);
    };

    // Mixing variable definitions with other initializers, which are executed in order.
    for (j = 3, k: Int = j * 10, i = k + 1), k < 32, ++k print("%d, %d, %d\n", j, k, i);

    // Defining variables with the var command.
    for (var k = 0), k < 2, ++k print("var k = %d\n", k);
    for (var k := 7), k < 9, ++k print("var k = %d\n", k);
    for (j = 4, var k = j * 10), k < 42, ++k print("%d, var k = %d\n", j, k);
    for (var k = 0, l = 10), k < 2, ++k print("var k = %d, l = %d\n", k, l);
    for (j = 2, var k = j, l = j * 2), k < 4, ++k print("var k = %d, l = %d\n", k, l);

    // Enclosing the var command in brackets to add initializers after it.
    for ((var k = 5), j = k * 2), k < 7, ++k print("var k = %d, j = %d\n", k, j);
    for ((var k = 0, l = 3), j = l), k < 2, ++k print("var k = %d, l = %d, j = %d\n", k, l, j);

    // Same variable name in sibling loops.
    for k: Int = 10, k < 12, ++k print("k = %d\n", k);

    // Header enclosed in brackets.
    for (k: Int = 20, k < 22, ++k) print("k = %d\n", k);

    // Non-block bodies.
    if 1 for k: Int = 0, k < 2, ++k print("if k = %d\n", k);
    for m: Int = 0, m < 2, ++m for n: Int = 0, n < 2, ++n print("%d, %d\n", m, n);

    // Loop vars are destroyed when the loop ends.
    for (c: Counter, k: Int = 0), k < 2, ++k c.n = k + 100;
    print("after loop\n");

    // Continuing and breaking outer loops.
    for m: Int = 0, m < 3, ++m {
      for n: Int = 0, n < 3, ++n {
        if n == 1 continue 2;
        if m == 2 break 2;
        print("%d, %d\n", m, n);
      };
    };
  };

  class Counter {
    def n: Int;
    handler this~init() { this.n = 0 };
    handler this~terminate() { print("~Counter %d\n", this.n) };
  };
};

Main.start();
