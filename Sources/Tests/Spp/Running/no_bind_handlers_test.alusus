import "Srl/Console";
use Srl;

class MyType {
    class VTable {
        handler (this: MyType).getVal(): Int {
            return this.i;
        };
    }
    @shared var s__vtable__: VTable;

    @no_bind handler this.vtable: ref[VTable] {
        return MyType.s__vtable__;
    };
    @no_bind handler this.getVTable(): ref[VTable] {
        return MyType.s__vtable__;
    };
    @no_bind handler this.ptrVTable: ref[VTable] as_ptr {
        return MyType.s__vtable__;
    };
    @no_bind handler this.ptrGetVTable(): ref[VTable] as_ptr {
        return MyType.s__vtable__;
    };

    var i: Int;

    handler this.printVals() {
        Console.print("this.vtable.getVal() = %d\n", this.vtable.getVal());
        Console.print("this.getVTable().getVal() = %d\n", this.getVTable().getVal());
    };
}

class Holder {
    var j: Int;
    handler this.getJ(): Int {
        return this.j;
    };
}

class Normal {
    var h: Holder;
    handler this.holder: ref[Holder] {
        return this.h;
    };
    handler this.getHolder(): ref[Holder] {
        return this.h;
    };
}

class Base {
    class VTable {
        handler (this: Base).describe() {
            Console.print("Base.describe: i = %d\n", this.i);
        };
    }
    @shared var s__vtable__: VTable;
    @no_bind @injection var vtable: ref[VTable](s__vtable__);
    var i: Int;
}

class Child {
    @injection var base: Base;
    class VTable {
        @injection var base: Base.VTable;
        handler (this: Child).childOnly() {
            Console.print("Child.childOnly: i + j = %d\n", this.base.i + this.j);
        };
    }
    @shared var s__vtable__: VTable;
    // Casts the base's vtable to the child's vtable. The base's vtable must be accessed through `this.base` since
    // `this.vtable` would refer to this same handler.
    @no_bind handler this.vtable: ref[VTable] {
        return this.base.vtable~ptr~cast[ptr[VTable]]~cnt;
    };
    @no_bind handler [T: type] this.typedVTable(): ref[VTable] {
        return this.vtable;
    };
    var j: Int;
    handler this~init() {
        this.base.vtable~no_deref = Child.s__vtable__~ptr~cast[ptr[Base.VTable]]~cnt;
    };
}

var t: MyType;
t.i = 7;
Console.print("t.vtable.getVal() = %d\n", t.vtable.getVal());
Console.print("(t.vtable).getVal() = %d\n", (t.vtable).getVal());
Console.print("t.getVTable().getVal() = %d\n", t.getVTable().getVal());
Console.print("t.ptrVTable.getVal() = %d\n", t.ptrVTable.getVal());
Console.print("t.ptrGetVTable().getVal() = %d\n", t.ptrGetVTable().getVal());
t.printVals();

var n: Normal;
n.h.j = 5;
Console.print("n.holder.getJ() = %d\n", n.holder.getJ());
Console.print("n.getHolder().getJ() = %d\n", n.getHolder().getJ());

var c: Child;
c.i = 3;
c.j = 4;
c.describe();
c.vtable.childOnly();
c.typedVTable[Int]().childOnly();
