import "Srl/Console.alusus";

use Srl.Console;

class InnerMost {
  def a: Int;
  handler this.getA():Int { return this.a }
  handler this=Int { this.a = value };
}

def im: InnerMost;

class Inner {
  @injection def rim: ref[InnerMost];
  rim~ptr = im~ptr;

  def i: Int;
  def j: Int;
  handler this.getI():Int { return this.i };
  handler this.getJ():Int { return this.j };
  handler this(): Int { return this.i + this.j }
}

class Outer {
  @injection def inner: Inner;
  def k: Int;
  a = 6;
  i = 7;
  k = 8;
}

def o: Outer;
print("o.a=%d, o.i=%d, o.j=%d, o.k=%d\n", o.a, o.i, o.j, o.k);

o.a = 1;
o.i = 2;
o.j = 3;
print("o.getA()=%d, o.getI()=%d, o.getJ()=%d, o()=%d\n", o.getA(), o.getI(), o.getJ(), o());

o.k = 4;
o = 17;

func getO ():ref[Outer] { return o }
print(
  "getO().getA()=%d, getO().getI()=%d, getO().j=%d, getO().k=%d, getO()()=%d\n",
  getO().getA(), getO().getI(), getO().j, getO().k, getO()()
);

// Test accessing a member of an injection through the auto injected `this` of member functions, and incorrectly
// accessing it through the auto generated `this` of the constructor from a non-member function.

class Parent {
    def result: Int;
}

class Child {
    @injection def parent: Parent;
    var j: Int = 0;

    handler this.test() {
        result = 5;
    }

    func nonMemberTest() {
        result = 6;
    }
}

def c: Child;
c.test();
print("c.result=%d\n", c.result);
Child.nonMemberTest();

// Test other injection errors

class Wrong {
  def i: Int;
  @injection def test: func {}
  @injection @member func method(this: ref[this_type]): ref[Outer] { return Outer() }
  @injection @operation[""] @member func tpl [T: type] (this: ref[this_type]): ref[Outer] { return Outer() }
};
def w: Wrong;
print("w.i=%d\n", w.i);
