import "Srl/Console";
import "Srl/Map";
import "Srl/String";
import "Core/Basic";
import "Core/Ast";
import "Spp";
import "Spp/Ast";
use Srl;
use Core.Basic;
use Core.Ast;
def AstTemplateMap: alias Map[String, ref[Core.Ast.Node]];

func printHello {
    Console.print("Hello\n");
}

func printSomething[str: string]() {
    Console.print(str);
}

func callSomething[f: function]() {
    f();
}

def var1: Int(2);
def var2: Int(3);

func preprocessTest1 {
    preprocess {
        // Regular function call.
        Spp.astMgr.insertAst(
            (ast fn()),
            AstTemplateMap().set(String("fn"), Passage(printHello~ast))
        )
        // Variables.
        Spp.astMgr.insertAst(
            (ast Console.print("%d\n", v1 + v2)),
            AstTemplateMap()
                .set(String("v1"), Passage(var1~ast))
                .set(String("v2"), Passage(var2~ast))
        )
        // Call a function template.
        def list: SrdRef[Core.Ast.List] = newSrdObj[Core.Ast.List];
        def listContainer: DynContainerOf[list.obj, Core.Ast.Node];
        listContainer.addElement(StringLiteral.create("Hello from a template\n"));
        def instance: SrdRef[Core.Ast.Node];
        Spp.astMgr.matchTemplateInstance(printSomething~ast~cast[ref[Spp.Ast.Template]], list.obj, instance);
        Spp.astMgr.insertAst(
            (ast fn()),
            AstTemplateMap().set(String("fn"), Passage(instance.obj))
        )
        // Call a function template receiving a funciton param.
        list = newSrdObj[Core.Ast.List];
        listContainer~no_deref = DynContainerOf[list.obj, Core.Ast.Node];
        listContainer.addElement(Passage.create(printHello~ast));
        Spp.astMgr.matchTemplateInstance(callSomething~ast~cast[ref[Spp.Ast.Template]], list.obj, instance);
        Spp.astMgr.insertAst(
            (ast fn()),
            AstTemplateMap().set(String("fn"), Passage(instance.obj))
        )
    }
}

preprocessTest1();

class Tester {
    def i: Int;
    handler this.print() {
        Console.print("Tester.i = %d\n", this.i);
    }
}

func preprocessTest2 {
    def t: Tester;
    t.i = 5;
    preprocess {
        // Member function call.
        Spp.astMgr.insertAst(
            (ast t.fn()),
            AstTemplateMap().set(String("fn"), Passage(Tester.print~ast))
        );
    }
}

preprocessTest2();

func preprocessTest3 {
    def fp1: ptr[function];
    def fp2: ptr[function];
    fp1 = preprocess {
        // Getting pointer to function
        Spp.astMgr.insertAst(
            (ast fn~ptr),
            AstTemplateMap().set(String("fn"), Passage(printHello~ast))
        );
    };
    preprocess {
        // Getting pointer to function
        Spp.astMgr.insertAst(
            (ast fp2 = fn~ptr),
            AstTemplateMap().set(String("fn"), Passage(printHello~ast))
        );
    };
    fp1();
    fp2();
}

preprocessTest3();
