import "alusus_spp";
module Core {
    module Basic {
        class TiObject {}
    }
    module Ast {
        class Node {}
    }
}
module Spp {
    class BuildMgr {
        @expname[Spp_BuildMgr_dumpLlvmIrForElement]
        handler this.dumpLlvmIrForElement (element: ref[Core.Ast.Node], debugInfo: Word[1]);

        handler this.dumpLlvmIrForElement (element: ref[Core.Ast.Node]) {
            this.dumpLlvmIrForElement(element, 0);
        }
    };
    def buildMgr: ref[BuildMgr];
}
