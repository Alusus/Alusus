//==============================================================================

@merge module Spp {
    def SeekerFlags: {
        def SKIP_OWNERS: 1u;
        def SKIP_OWNED: 2u;
        def SKIP_USES: 4u;
        def SKIP_CHILDREN: 0h10000u;
    };

    def DefinitionDomain: {
        def FUNCTION: 0;
        def OBJECT: 1;
        def GLOBAL: 2;
    };

    class GrammarMgr {
        use Core.Ast;

        @expname[Spp_GrammarMgr_addCustomCommand]
        handler this.addCustomCommand (
            qualifier: ptr[array[Char]], grammarAst: ref[Node],
            handler: ptr[func (Srl.SrdRef[Node]): Srl.SrdRef[Node]]
        );

        @expname[Spp_GrammarMgr_addCustomGrammar]
        handler this.addCustomGrammar (
            qualifier: ptr[array[Char]], baseQualifier: ptr[array[Char]], grammarAst: ref[Node]
        );
    };
    def grammarMgr: ref[GrammarMgr];

    class AstMgr {
        use Srl;
        use Core.Basic;
        use Core.Ast;
        def AstTemplateMap: alias Map[String, ref[Node]];

        @expname[Spp_AstMgr_findElements]
        handler this.findElements(
            comparison: ref[Node],
            target: ref[Node],
            flags: Word
        ): Array[ref[Node]];

        handler this.findElements(
            comparison: ref[Node],
            target: ref[Node],
            flags: Word,
            modifierKwd: CharsPtr,
            kwdTranslations: ref[Map[String, String]]
        ): Array[ref[Node]] {
            var elements: Array[ref[Node]] = this.findElements(comparison, target, flags);
            def result: Array[ref[Node]];
            def i: Int;
            for i = 0, i < elements.getLength(), ++i {
                if modifierKwd != 0
                and this.findModifierForElement(elements(i), modifierKwd, kwdTranslations)~ptr == 0 {
                    continue;
                }
                result.add(elements(i));
            }
            return result;
        }

        handler this.getDefinitionName (element: ref[Node]): String {
            def d: ref[Definition](castRef[element.owner, Definition]);
            return d.name.value;
        }

        @expname[Spp_AstMgr_getModifiers]
        handler this.getModifiers(element: ref[Node]): ref[Containing[Node]];

        @expname[Spp_AstMgr_findModifier]
        handler this.findModifier(
            modifiers: ref[Containing[Node]], kwd: ptr[array[Char]]
        ): ref[Node];

        @expname[Spp_AstMgr_findModifierForElement]
        handler this.findModifierForElement(
            element: ref[Node], kwd: ptr[array[Char]]
        ): ref[Node];

        handler this.findModifierForElement (
            element: ref[Node],
            kwd: ptr[array[Char]],
            kwdTranslations: ref[Map[String, String]]
        ): ref[Node] {
            def modifiers: ref[Containing[Node]](this.getModifiers(element));
            if modifiers~ptr == 0 return nullRef[Node];
            def i: Int;
            for i = 0, i < modifiers.getElementCount()~cast[Int], ++i {
                def modifier: ref[Node](modifiers.getElement(i));
                if modifier~ptr == 0 continue;
                var modKwd: String = this.getModifierKeyword(modifier);
                var translationIndex: ArchInt = kwdTranslations.findPos(modKwd);
                def translatedKwd: String;
                if translationIndex == -1 translatedKwd = modKwd
                else translatedKwd = kwdTranslations.valAt(translationIndex);
                // If the translation is empty for whatever reason, we'll just ignore it
                // and use the untranslated keyword.
                if translatedKwd == "" translatedKwd = modKwd;
                if translatedKwd == kwd return modifier;
            }
            return nullRef[Node];
        }

        @expname[Spp_AstMgr_getModifierKeyword]
        handler this.getModifierKeyword(modifier: ref[Node]): String;

        @expname[Spp_AstMgr_getModifierParams]
        handler this.getModifierParams(
            modifier: ref[Node], result: ref[Array[ref[Node]]]
        ) => Word[1];

        @expname[Spp_AstMgr_getModifierStringParams]
        handler this.getModifierStringParams(
            modifier: ref[Node], result: ref[Array[String]]
        ) => Word[1];

        @expname[Spp_AstMgr_getStringsFromStringParams]
        handler this.getStringsFromStringParams(
            params: ref[Node], result: ref[Array[String]]
        ) => Word[1];

        @expname[Spp_AstMgr_addPossiblyMergeableElement]
        handler this.addPossiblyMergeableElement(
            node: ref[Node], target: ref[DynamicContaining[Node]], index: ref[Int]
        ) => Word[1];

        handler this.getClassVars(parent: ref[Node]): Array[ref[Node]] {
            return this.findElements(
                (ast elementType == "var"),
                parent,
                SeekerFlags.SKIP_OWNERS | SeekerFlags.SKIP_USES | SeekerFlags.SKIP_CHILDREN
            );
        }

        handler this.getClassVars(
            parent: ref[Node], modifierKwd: CharsPtr, kwdTranslations: ref[Map[String, String]]
        ): Array[ref[Node]] {
            return this.findElements(
                (ast elementType == "var"),
                parent,
                SeekerFlags.SKIP_OWNERS | SeekerFlags.SKIP_USES | SeekerFlags.SKIP_CHILDREN,
                modifierKwd,
                kwdTranslations
            );
        }

        handler this.getClassVarNames(parent: ref[Node]): Array[String] {
            return this.getClassVarNames(parent, 0, Map[String, String]());
        }

        handler this.getClassVarNames(
            parent: ref[Node], modifierKwd: CharsPtr, kwdTranslations: ref[Map[String, String]]
        ): Array[String] {
            var vars: Array[ref[Node]] = this.getClassVars(parent, modifierKwd, kwdTranslations);
            def result: Array[String];
            def i: Int;
            for i = 0, i < vars.getLength(), ++i {
                result.add(this.getDefinitionName(vars(i)));
            }
            return result;
        }

        handler this.getClassFuncs(parent: ref[Node]): Array[ref[Node]] {
            return this.findElements(
                (ast elementType == "function"),
                parent,
                SeekerFlags.SKIP_OWNERS | SeekerFlags.SKIP_USES | SeekerFlags.SKIP_CHILDREN
            );
        }

        handler this.getClassFuncs(
            parent: ref[Node], modifierKwd: CharsPtr, kwdTranslations: ref[Map[String, String]]
        ): Array[ref[Node]] {
            return this.findElements(
                (ast elementType == "function"),
                parent,
                SeekerFlags.SKIP_OWNERS | SeekerFlags.SKIP_USES | SeekerFlags.SKIP_CHILDREN,
                modifierKwd,
                kwdTranslations
            );
        }

        handler this.getClassFuncNames(parent: ref[Node]): Array[String] {
            return this.getClassFuncNames(parent, 0, Map[String, String]());
        }

        handler this.getClassFuncNames(
            parent: ref[Node], modifierKwd: CharsPtr, kwdTranslations: ref[Map[String, String]]
        ): Array[String] {
            var funcs: Array[ref[Node]] = this.getClassFuncs(parent, modifier, kwdTranslations);
            def result: Array[String];
            def i: Int;
            for i = 0, i < funcs.getLength(), ++i {
                result.add(this.getDefinitionName(funcs(i)));
            }
            return result;
        }

        handler this.getFuncArgTypes (element: ref[Node]): ref[Node] {
            def fnType: ref[Node](MapContainerOf[element, Node].getElement("type"));
            return MapContainerOf[fnType, Node].getElement("argTypes");
        }

        handler this.getFuncArgType (element: ref[Node], index: Int): ref[Node] {
            ContainerOf[this.getFuncArgTypes(element), Node].{
                if getElementCount()~cast[Int] <= index return nullRef[Node]
                else return getElement(index);
            }
        }

        @expname[Spp_AstMgr_getSourceFullPathForElement]
        handler this.getSourceFullPathForElement(element: ref[Node]) => String;

        handler this.getSourceDirectoryForElement(element: ref[Node]) => String {
            var fullPath: String = this.getSourceFullPathForElement(element);
            return fullPath.slice(0, fullPath.findLast('/') + 1);
        }

        @expname[Spp_AstMgr_insertAst]
        handler this.insertAst(element: ref[Node]) => Word[1];

        @expname[Spp_AstMgr_insertAst_plain]
        handler this.insertAst(
            element: ref[Node],
            interpolations: ref[Map[String, ref[Node]]]
        ) => Word[1];

        @expname[Spp_AstMgr_insertAst_shared]
        handler this.insertAst(
            element: ref[Node],
            interpolations: ref[Map[String, SrdRef[Node]]]
        ) => Word[1];

        @expname[Spp_AstMgr_buildAst_plain]
        handler this.buildAst(
            element: ref[Node],
            interpolations: ref[Map[String, ref[Node]]],
            result: ref[SrdRef[Node]]
        ) => Word[1];

        @expname[Spp_AstMgr_buildAst_shared]
        handler this.buildAst(
            element: ref[Node],
            interpolations: ref[Map[String, SrdRef[Node]]],
            result: ref[SrdRef[Node]]
        ) => Word[1];

        handler this.buildAst(
            tree: ref[Node], args: ref[Map[String, ref[Node]]]
        ): SrdRef[Node] {
            def result: SrdRef[Node];
            this.buildAst(tree, args, result);
            return result;
        }

        @expname[Spp_AstMgr_getCurrentPreprocessOwner]
        handler this.getCurrentPreprocessOwner(): ref[Node];

        @expname[Spp_AstMgr_preprocessTypeBody]
        handler this.preprocessTypeBody(type: ref[Spp.Ast.UserType]) => Word[1];

        @expname[Spp_AstMgr_getCurrentPreprocessInsertionPosition]
        handler this.getCurrentPreprocessInsertionPosition(): Int;

        @expname[Spp_AstMgr_getVariableDomain]
        handler this.getVariableDomain(element: ref[Node]) => Int;

        @expname[Spp_AstMgr_traceType]
        handler this.traceType(element: ref[Node]) => ref[Spp.Ast.Type];

        @expname[Spp_AstMgr_matchTemplateInstance]
        handler this.matchTemplateInstance(
            template: ref[Spp.Ast.Template], templateInput: ref[Node], result: ref[SrdRef[Node]]
        ) => Bool;

        @expname[Spp_AstMgr_isCastableTo]
        handler this.isCastableTo(srcTypeRef: ref[Node], targetTypeRef: ref[Node], implicit: Bool) => Bool;

        @expname[Spp_AstMgr_computeResultType]
        handler this.computeResultType(
            element: ref[Node], result: ref[ref[Node]], resultIsValue: ref[Bool]
        ) => Bool;

        @expname[Spp_AstMgr_cloneAst]
        handler this.cloneAst(
            element: ref[Node], sourceLocationNode: ref[Node]
        ): SrdRef[Node];
        handler this.cloneAst(element: ref[Node]): SrdRef[Node] {
            return this.cloneAst(element, nullRef[Node]);
        }

        @expname[Spp_AstMgr_dumpAst]
        handler this.dumpAst(obj: ref[Node]);

        @expname[Spp_AstMgr_getReferenceTypeFor]
        handler this.getReferenceTypeFor(astType: ref[Node]): ref[Spp.Ast.ReferenceType];

        @expname[Spp_AstMgr_tryGetDeepReferenceContentType]
        handler this.tryGetDeepReferenceContentType(astType: ref[Spp.Ast.Type]): ref[Spp.Ast.Type];

        @expname[Spp_AstMgr_isInjection]
        handler this.isInjection(obj: ref[Node]): Bool;

        handler this.insertCopyHandlers(obj: ref[Node]) {
            var varNames: Array[String] = this.getClassVarNames(obj);
            var assignments: SrdRef[Within] = newSrdObj[Within];
            var assignmentsList: SrdRef[Core.Ast.List] = newSrdObj[Core.Ast.List];
            MapContainerOf[assignments.obj, Node].setElement("subject", assignmentsList.obj);
            var assignContainer := DynContainerOf[assignmentsList.obj, Node];
            var i: Int;
            for i = 0, i < varNames.getLength(), ++i {
                var payloadAssignment: SrdRef[Node] = Spp.astMgr.buildAst(
                    (ast this.varName~no_deref = value.varName),
                    AstTemplateMap().set(String("varName"), Identifier(varNames(i)))
                );
                assignContainer.addElement(payloadAssignment.obj);
            }
            this.insertAst(
                ast {
                    handler this~init(ref[this_type]) { this = value }
                    handler this = ref[this_type] {
                        assignments
                    }
                },
                AstTemplateMap().{
                    set(String("assignments"), assignments.obj);
                }
            );
        }
        @member macro insertCopyHandlers [this] preprocess { this.insertCopyHandlers(this_type~ast) }

        handler this.insertMixin(obj: ref[Node]) {
            def bitwiseOp: ref[BitwiseOperator](dynCastRef[obj, BitwiseOperator]);
            if bitwiseOp~ptr != 0 {
                this.insertMixin(MapContainerOf[bitwiseOp, Node].getElement("first"));
                this.insertMixin(MapContainerOf[bitwiseOp, Node].getElement("second"));
                return;
            }
            if isDerivedFrom[obj, ParamPass] or isDerivedFrom[obj, LinkOperator] or isDerivedFrom[obj, Identifier] {
                var elements: Array[ref[Node]] = this.findElements(
                    obj, castRef[obj, Node].owner, 0
                );
                if elements.getLength() == 0 {
                    buildMgr.raiseBuildNotice("SPPA1007", 1, obj);
                    return;
                }
                def i: Int;
                for i = 0, i < elements.getLength(), ++i this.insertMixin(elements(i));
                return;
            }
            def scope: ref[Scope](dynCastRef[obj, Scope]);
            if scope~ptr == 0 {
                this.insertAst(obj);
                return;
            }
            def container: ContainerOf[scope, Node];
            def i: Word;
            for i = 0, i < container.getElementCount(), ++i {
                this.insertAst(container.getElement(i));
            }
        }
        @member macro insertMixin [this, target] preprocess { this.insertMixin(target~ast) }
    };
    def astMgr: ref[AstMgr];

    class BuildMgr {
        use Core.Ast;

        @expname[Spp_BuildMgr_dumpLlvmIrForElement]
        handler this.dumpLlvmIrForElement (element: ref[Node], debugInfo: Word[1]);

        handler this.dumpLlvmIrForElement (element: ref[Node]) {
            this.dumpLlvmIrForElement(element, 0);
        }

        @expname[Spp_BuildMgr_buildObjectFileForElement]
        handler this.buildObjectFileForElement (
            element: ref[Core.Ast.Node], filename: ptr[array[Word[8]]], targetTriple: ptr[array[Word[8]]],
            optimize: Word[1]
        ) => Word[1];
        handler this.buildObjectFileForElement (
            element: ref[Core.Ast.Node], filename: ptr[array[Word[8]]], targetTriple: ptr[array[Word[8]]]
        ) => Word[1] {
            return this.buildObjectFileForElement(element, filename, targetTriple, 0);
        }

        @expname[Spp_BuildMgr_raiseBuildNotice]
        handler this.raiseBuildNotice (
            code: ptr[array[Word[8]]], severity: Int, astNode: ref[Node]
        );
    };
    def buildMgr: ref[BuildMgr];
};
