import "Console";

@merge module Srl {
    module System {
        @expname[system]
        func exec(filename: CharsPtr): Int;

        @expname[usleep]
        func sleep(d: Word): Int;

        @expname[setenv]
        func setEnv(name: CharsPtr, value: CharsPtr, overwrite: Int): Int;

        @expname[getenv]
        func getEnv(name: CharsPtr): CharsLptr;

        @expname[exit]
        func exit(Int);

        func fail(code: Int, msg: CharsPtr) {
            Console.print("Error: %s\n", msg);
            exit(code);
        };
    };
};
