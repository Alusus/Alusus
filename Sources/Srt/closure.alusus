//==============================================================================

import "Srl/Map";
import "Srl/refs";
import "Core/Basic";
import "Core/Ast";
import "Spp";
import "Spp/Ast";

module Closures {
    use Srl;
    use Core.Basic;
    use Core.Ast;
    var captureModeTranslations: Map[String, String];

    def AstNode: alias Core.Ast.Node;
    def AstNodeSrdRef: alias SrdRef[AstNode];
    def AstTemplateMap: alias Map[String, ref[AstNode]];

    class Closure [FnType:type] {
        preprocess {
            fillClosureBody(FnType~ast);
        }
        var data: SrdRef[void];

        handler this~init() {}
        handler this~init(value: ref[this_type]) {
            this.data = value.data;
            this.fp = value.fp;
        }
        handler this=ref[this_type] {
            this.data = value.data;
            this.fp = value.fp;
        }
        handler this.release() {
            this.fp = 0;
            this.data.release();
        }
        handler this.isNull(): Bool return this.fp == 0;
        handler this == ref[this_type] return this.data.obj~ptr == value.data.obj~ptr;
    }

    func fillClosureBody (rawFnType: ref[AstNode]) {
        var fnType: AstNodeSrdRef = generateFuncType(rawFnType, nullRef[AstNode], (ast ref[Srl.RefCounter]), true);
        var argList: AstNodeSrdRef = generateFuncArgListFromType(fnType.obj);

        var call: AstNodeSrdRef;
        if argList.obj~ptr != 0 {
            call = Spp.astMgr.buildAst(
                (ast this.fp(args)),
                AstTemplateMap().set(String("args"), argList.obj),
            );
        } else {
            call = Spp.astMgr.buildAst((ast this.fp()), AstTemplateMap());
        }
        var statement: AstNodeSrdRef;
        if isVoidRetType(fnType.obj) {
            statement = call;
        } else {
            statement = Spp.astMgr.buildAst(
                (ast return call),
                AstTemplateMap().set(String("call"), call.obj)
            );
        }
        var fn: AstNodeSrdRef = Spp.astMgr.buildAst(
            (ast func { statement }),
            AstTemplateMap().set(String("statement"), statement.obj),
        );
        MapContainerOf[fn.obj, AstNode].setElement(
            "type",
            generateFuncType(rawFnType, (ast ref[this_type]), nullRef[AstNode], true).obj
        );

        Spp.astMgr.insertAst(
            (ast def name: fn),
            AstTemplateMap()
                .set(String("name"), StringLiteral("()"))
                .set(String("fn"), fn.obj)
        );
        Spp.astMgr.insertAst(
            (ast var fp: ptr[fnType] = 0),
            AstTemplateMap().set(String("fnType"), fnType.obj)
        );
    }

    func generateClosureInstance (
        rawFnTypeSpec: ref[AstNode], statements: ref[AstNode], owner: ref[AstNode]
    ): AstNodeSrdRef {
        // Generate the function.
        var fn: AstNodeSrdRef = Spp.astMgr.buildAst(
            (ast function {
                @injection var __data: ref[Data];
                __data~ptr = __payload.managedObj~cast[ptr[Data]];

                statements
            }),
            AstTemplateMap().set(String("statements"), statements)
        );
        // Extract payload mode defs.
        var payloadModeDefs: Core.Ast.Map;
        var fnTypeSpec: AstNodeSrdRef;
        extractPayloadVarDefs(rawFnTypeSpec, fnTypeSpec, payloadModeDefs);
        var payloadModeDefsMap: ref[Core.Basic.MapContaining[AstNode]](MapContainerOf[payloadModeDefs, AstNode]);
        // Assign the function type.
        var closureArgFnType: AstNodeSrdRef = generateFuncType(fnTypeSpec, nullRef[AstNode], nullRef[AstNode], false);
        var fnType: AstNodeSrdRef = generateFuncType(fnTypeSpec, nullRef[AstNode], (ast ref[Srl.RefCounter]), false);
        MapContainerOf[fn.obj, AstNode].setElement("type", fnType.obj);
        // Find external variables of that function.
        var varDefs: AstTemplateMap;
        findExternalVariables(getInterface[fn.obj, Containing[AstNode]].getElement(1), owner, varDefs);
        // Generate member var definitions and assignments.
        var payloadDefs: SrdRef[MergeList] = newSrdObj[MergeList];
        var defsContainer:: DynContainerOf[payloadDefs.obj, AstNode];
        var payloadAssignments: SrdRef[MergeList] = newSrdObj[MergeList];
        var assignContainer:: DynContainerOf[payloadAssignments.obj, AstNode];
        var i: Int;
        for i = 0, i < varDefs.getLength(), ++i {
            var useNoDeref: Bool;
            var payloadDef: AstNodeSrdRef = Spp.astMgr.buildAst(
                (ast var varName: varType),
                AstTemplateMap()
                    .set(String("varName"), StringLiteral(varDefs.keys(i).buf))
                    .set(String("varType"), createPayloadVarType(
                        varDefs.values(i),
                        ref[AstNode]().{
                            var index: Int = payloadModeDefsMap.findElementIndex(varDefs.keys(i));
                            if index == -1 this~ptr = 0
                            else this~ptr = payloadModeDefsMap.getElement(index)~ptr;
                        },
                        useNoDeref
                    ).obj)
            );
            defsContainer.addElement(payloadDef.obj);
            var payloadAssignment: AstNodeSrdRef;
            if useNoDeref {
                payloadAssignment = Spp.astMgr.buildAst(
                    (ast __d.varName~no_deref = varName),
                    AstTemplateMap().set(String("varName"), Identifier(varDefs.keys(i)))
                );
            } else {
                payloadAssignment = Spp.astMgr.buildAst(
                    (ast __d.varName = varName),
                    AstTemplateMap().set(String("varName"), Identifier(varDefs.keys(i)))
                );
            }
            assignContainer.addElement(payloadAssignment.obj);
        }
        // Render the closure.
        return Spp.astMgr.buildAst(
            ast {
                Closures.Closure[closureArgFnType]()~use_in(__this) no_injection {
                    class Data {
                        payloadDefs
                    }
                    var __d: Srl.SrdRef[Data];
                    __d.construct();

                    payloadAssignments;

                    __this.data.assign(__d.refCounter, castRef[__d.obj, void]);
                    __this.fp = fn;
                }
            },
            AstTemplateMap().{
                set(String("closureArgFnType"), closureArgFnType.obj);
                set(String("payloadDefs"), payloadDefs.obj);
                set(String("payloadAssignments"), payloadAssignments.obj);
                set(String("fn"), fn);
            }
        );
    }

    func extractPayloadVarDefs (
        fnTypeSpec: ref[AstNode], fnTypeSpecResult: ref[AstNodeSrdRef], payloadSpec: ref[Core.Ast.Map]
    ) {
        var linkOp: ref[LinkOperator](dynCastRef[fnTypeSpec, LinkOperator]);
        if linkOp~ptr != 0 {
            var recursiveRes: AstNodeSrdRef;
            extractPayloadVarDefs(MapContainerOf[linkOp, AstNode].getElement("first"), recursiveRes, payloadSpec);
            fnTypeSpecResult = newSrdObj[LinkOperator].{
                BindingOf[this].setMember("type", TiStr(":"));
                MapContainerOf[this, AstNode].setElement("first", recursiveRes);
                MapContainerOf[this, AstNode].setElement("second", MapContainerOf[linkOp, AstNode].getElement("second"));
            };
            return;
        }

        var bitwiseOp: ref[BitwiseOperator](dynCastRef[fnTypeSpec, BitwiseOperator]);
        if bitwiseOp~ptr != 0 {
            var rawPayloadDefs: ref[AstNode](MapContainerOf[bitwiseOp, AstNode].getElement("first"));
            addFuncArgs(rawPayloadDefs, 0, DynMapContainerOf[payloadSpec, AstNode], false);
            fnTypeSpecResult = castSrdRef[
                MapContainerOf[bitwiseOp, AstNode].getElement("second").wkThis, AstNode
            ];
            return;
        }

        fnTypeSpecResult = castSrdRef[fnTypeSpec.wkThis, AstNode];
    }

    func createPayloadVarType (
        varTypeRef: ref[AstNode], captureMode: ref[AstNode], useNoDeref: ref[Bool]
    ): AstNodeSrdRef {
        var varType: ref[Spp.Ast.Type](Spp.astMgr.traceType(varTypeRef));
        var identifier: ref[Identifier](dynCastRef[captureMode, Identifier]);
        if identifier~ptr != 0 {
            var captureMode: String = captureModeTranslations(identifier.value.value);
            if captureMode == "" captureMode = identifier.value.value;
            if captureMode == "by_ref" {
                // Capture by reference.
                varType~no_deref = castRef[Spp.astMgr.getReferenceTypeFor(varType), Spp.Ast.Type];
                useNoDeref = true;
            } else if captureMode == "by_val" {
                // Capture by value.
                varType~no_deref = Spp.astMgr.tryGetDeepReferenceContentType(varType);
                useNoDeref = false;
            } else if captureMode == "identical" {
                // Capture by exact copy
                useNoDeref = true;
            } else {
                Spp.buildMgr.raiseBuildNotice("SRT1001", 1, identifier);
            }
        } else if captureMode~ptr != 0 {
            Spp.buildMgr.raiseBuildNotice("SRT1001", 1, captureMode);
        } else {
            // Automatic determination of capture mode.
            // We'll use capture-by-value mode if the content type is basic data types or one of the following
            // types: SrdRef, String, Array, Map.
            // We'll use exact mode otherwise, i.e. if the content type is a user type that isn't one of the
            // types mentioned above.
            var contentType: ref[Spp.Ast.Type](Spp.astMgr.tryGetDeepReferenceContentType(varType));
            if isDerivedFrom[contentType, Spp.Ast.UserType]
            and !contentType.isOwnedBy(SrdRef~ast) 
            and !contentType.isOwnedBy(Array~ast)
            and !contentType.isOwnedBy(Map~ast)
            and !contentType.isOwnedBy(StringBase~ast) {
                useNoDeref = true;
            } else {
                varType~no_deref = contentType;
                useNoDeref = false;
            }
        }
        return newSrdObj[Spp.Ast.Variable].{
            MapContainerOf[this, AstNode].setElement("type", varType);
        };
    }

    func generateFuncType (
        t: ref[AstNode], thisType: ref[AstNode], payloadType: ref[AstNode], useBox: Bool
    ): AstNodeSrdRef {
        var args: ref[AstNode];
        var retVal: ref[AstNode];
        if isDerivedFrom[t, Spp.Ast.FunctionType] or isDerivedFrom[t, LinkOperator] {
            ContainerOf[t, AstNode].{
                args~no_deref = this.getElement(0);
                retVal~no_deref = this.getElement(1);
            }
        } else {
            args~no_deref = t;
            retVal~ptr = 0;
        }
        var inputs: SrdRef[Core.Ast.Map] = newSrdObj[Core.Ast.Map];
        DynMapContainerOf[inputs.obj, AstNode].{
            if thisType~ptr != 0 this.addElement("this", thisType);
            addFuncArgs(args, 0, this, useBox);
            if payloadType~ptr != 0 this.addElement("__payload", payloadType);
        };
        var retTypeVariable: SrdRef[Spp.Ast.Variable];
        if useBox and retVal~ptr != 0 {
            var targetType: ref[Spp.Ast.Type](Spp.astMgr.traceType(retVal));
            if targetType~ptr == 0 retVal~ptr = 0
            else {
                retTypeVariable = newSrdObj[Spp.Ast.Variable].{
                    MapContainerOf[this, AstNode].setElement("type", targetType);
                };
                retVal~no_deref = retTypeVariable.obj;
            }
        }
        var fnType: AstNodeSrdRef = AstNodeSrdRef().{
            if thisType~ptr != 0 this = Spp.astMgr.cloneAst(ast @member func)
            else this = Spp.astMgr.cloneAst(ast func);
        };
        MapContainerOf[fnType.obj, AstNode].{
            this.setElement("argTypes", inputs.obj);
            this.setElement("retType", retVal);
        };
        return fnType;
    }

    func addFuncArgs (input: ref[AstNode], index: Int, map: ref[DynamicMapContaining[AstNode]], useBox: Bool) {
        if input~ptr == 0 return;
        var inputContaining:: ContainerOf[input, AstNode];
        if isDerivedFrom[input, Bracket] {
            addFuncArgs(inputContaining.getElement(0), index, map, useBox);
        } else if isDerivedFrom[input, Core.Ast.Map] {
            getInterface[input, MapContaining[AstNode]].{
                var i: Word;
                for i = 0, i < inputContaining.getElementCount(), ++i {
                    var inputObj: ref[AstNode](this.getElement(i));
                    if useBox {
                        var targetType: ref[Spp.Ast.Type](Spp.astMgr.traceType(inputObj));
                        if targetType~ptr == 0 continue;
                        map.addElement(this.getElementKey(i), newSrdObj[Spp.Ast.Variable].{
                            MapContainerOf[this, AstNode].setElement("type", targetType);
                        });
                    } else {
                        map.addElement(this.getElementKey(i), Spp.astMgr.cloneAst(inputObj));
                    }
                }
            };
        } else if isDerivedFrom[input, Core.Ast.List] {
            var i: Word;
            for i = 0, i < inputContaining.getElementCount(), ++i {
                addFuncArgs(inputContaining.getElement(i), i, map, useBox);
            }
        } else if isDerivedFrom[input, LinkOperator] and isStringPropEqual(input, "type", ":") {
            dynCastRef[inputContaining.getElement(0), Identifier].{
                // Make sure the argument name is valid.
                if this~ptr == 0  or map.findElementIndex(this.value.value) != -1 {
                    Spp.buildMgr.raiseBuildNotice("SPPH1006", 1, input);
                    return;
                }
                if useBox {
                    var targetType: ref[Spp.Ast.Type](Spp.astMgr.traceType(inputContaining.getElement(1)));
                    if targetType~ptr != 0 {
                        map.addElement(this.value.value, newSrdObj[Spp.Ast.Variable].{
                            MapContainerOf[this, AstNode].setElement("type", targetType);
                        });
                    }
                } else {
                    map.addElement(this.value.value, Spp.astMgr.cloneAst(inputContaining.getElement(1)));
                }
            };
        } else {
            if useBox {
                var targetType: ref[Spp.Ast.Type](Spp.astMgr.traceType(input));
                if targetType~ptr != 0 {
                    map.addElement(String("__") + index, newSrdObj[Spp.Ast.Variable].{
                        MapContainerOf[this, AstNode].setElement("type", targetType);
                    });
                }
            } else {
                map.addElement(String("__") + index, Spp.astMgr.cloneAst(input));
            }
        }
    }

    func isStringPropEqual(item: ref[AstNode], name: CharsPtr, value: CharsPtr): Bool {
        var bindings:: BindingOf[item];
        if bindings~ptr == 0 return false;
        var prop: ref[TiObject](bindings.getMember(name));
        if prop~ptr == 0 or not isDerivedFrom[prop, TiStr] return false;
        return castRef[prop, TiStr].value == value;
    }

    func generateFuncArgListFromType (fnType: ref[AstNode]): AstNodeSrdRef {
        var args: ref[AstNode](ContainerOf[fnType, AstNode].getElement(0));
        if args~ptr == 0 return AstNodeSrdRef();
        var argsMap:: MapContainerOf[args, AstNode];
        var list: SrdRef[Core.Ast.List] = newSrdObj[Core.Ast.List];
        var listContainer:: DynContainerOf[list.obj, AstNode];
        var i: Word;
        for i = 0, i < argsMap.getElementCount() - 1, ++i {
            var arg: SrdRef[Identifier] = newSrdObj[Identifier];
            arg.value.value = String(argsMap.getElementKey(i).buf);
            listContainer.addElement(arg.obj);
        }
        listContainer.addElement(Spp.astMgr.cloneAst(ast this.data.refCounter).obj);
        return list;
    }

    func findExternalVariables (
        obj: ref[AstNode], injectionPos: ref[AstNode], result: ref[AstTemplateMap]
    ) {
        if obj~ptr == 0 return;

        if isDerivedFrom[obj, Identifier] {
            if result.findPos(castRef[obj, Identifier].value.value) == -1 {
                var d: ref[AstNode](findDefinition(obj, castRef[obj, Identifier].owner));
                if d~ptr == 0 {
                    // The variable was not found in the function itself, so it's an external var.
                    d~no_deref = findDefinition(obj, injectionPos);
                    if d~ptr != 0 and isVarDefinition(d) {
                        // Only add the variable if it's local to the outer function.
                        if Spp.astMgr.getVariableDomain(d) == Spp.DefinitionDomain.FUNCTION {
                            result(castRef[obj, Identifier].value.value)~no_deref = d;
                        }
                    }
                }
            }
            return;
        } else if isDerivedFrom[obj, LinkOperator] {
            ContainerOf[obj, AstNode].{
                findExternalVariables(this.getElement(0), injectionPos, result);
                var second: ref[AstNode](this.getElement(1));
                if !isDerivedFrom[second, Identifier] {
                    findExternalVariables(second, injectionPos, result);
                }
            };
            return;
        } else if isDerivedFrom[obj, Spp.Ast.Function] or isDerivedFrom[obj, Spp.Ast.Type] {
            return;
        }

        ContainerOf[obj, AstNode].{
            if this~ptr != 0 {
                var i: Int;
                for i = 0, i < this.getElementCount()~cast[Int], ++i {
                    findExternalVariables(this.getElement(i), injectionPos, result);
                }
            }
        }
    }

    func findDefinition (obj: ref[AstNode], parent: ref[AstNode]): ref[AstNode] {
        var elements: Array[ref[AstNode]];
        elements = Spp.astMgr.findElements(obj, parent, Spp.SeekerFlags.SKIP_CHILDREN);
        if elements.getLength() > 0 return elements(0)
        else return nullRef[AstNode];
    }

    func isVoidRetType (fnType: ref[AstNode]): Bool {
        var retType: ref[AstNode](MapContainerOf[fnType, AstNode].getElement("retType"));
        if retType~ptr == 0 return true;
        var identifier: ref[Identifier](dynCastRef[retType, Identifier]);
        if identifier~ptr == 0 return false;
        return identifier.value.value.toLowerCase() == "void";
    }

    func isVarDefinition (obj: ref[AstNode]): Bool {
        return isDerivedFrom[obj, ParamPass]
            or isDerivedFrom[obj, LinkOperator]
            or isDerivedFrom[obj, Identifier]
            or isDerivedFrom[obj, Spp.Ast.ThisTypeRef]
            or isDerivedFrom[obj, Spp.Ast.TypeOp]
            or isDerivedFrom[obj, Spp.Ast.Variable];
    }
}

preprocess {
    use Srl;
    use Core.Basic;
    use Closures;

    // Pre-generate needed types.
    Spp.Ast.Type;
    Spp.Ast.Variable;

    Spp.grammarMgr.addCustomGrammar(
        "ClosureSigExp",
        "FuncSigExpression",
        ast {
            BitwiseExp.vars: { enable: 1 }
        }
    );

    Spp.grammarMgr.addCustomCommand(
        "Closure",
        (ast {
            keywords: "closure" | "مغلفة";
            args: "module".ClosureSigExp*(1,1) + "module".BlockSet*(0,1);
        }),
        func (data: AstNodeSrdRef): AstNodeSrdRef {
            var container:: ContainerOf[data.obj, AstNode];
            if container.getElementCount() == 2u {
                // Generate closure type reference.
                var closureArgFnType: AstNodeSrdRef = generateFuncType(
                    container.getElement(1), nullRef[AstNode], nullRef[AstNode], false
                );
                return Spp.astMgr.buildAst(
                    (ast Closures.Closure[t]),
                    AstTemplateMap().set(String("t"), closureArgFnType.obj)
                );
            } else {
                // Generate closure instance.
                var transformStatement: SrdRef[Spp.Ast.PreGenTransformStatement];
                transformStatement.{
                    construct();
                    MapContainerOf[obj, AstNode].setElement("body", data);
                    BindingOf[obj].setMember("transform", TiPtr(function (data: ref[AstNode]): AstNodeSrdRef {
                        var container:: ContainerOf[data, AstNode];
                        return Closures.generateClosureInstance(
                            container.getElement(1), container.getElement(2), castRef[data, AstNode].owner
                        );
                    }));
                };
                return Spp.astMgr.buildAst(
                    (ast t),
                    AstTemplateMap().set(String("t"), transformStatement.obj)
                );
            }
        }
    );

    captureModeTranslations.{
        this(String("كسند")) = String("by_ref");
        this(String("كقيمة")) = String("by_val");
        this(String("مطابق")) = String("identical");
    }
}
